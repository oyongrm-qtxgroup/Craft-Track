<UserControl x:Class="CraftTrack.Views.OrderDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CraftTrack.Converters"
             xmlns:enums="clr-namespace:CraftTrack.Models.Enums">

    <UserControl.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
            <StackPanel MaxWidth="860" Margin="0,0,0,32">
                <!-- Error Message -->
                <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{DynamicResource DangerTextBrush}" Width="18" Height="18"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="13" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>

                <!-- Stock Warning -->
                <Border Background="#FFF3E0" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                        Visibility="{Binding StockWarningMessage, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="AlertOutline" Foreground="#E65100" Width="18" Height="18"
                                                 VerticalAlignment="Top" Margin="0,2,8,0" />
                        <TextBlock Text="{Binding StockWarningMessage}" Foreground="#E65100" FontSize="13"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- ══════ Customer Section ══════ -->
                <TextBlock Text="Customer Information" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBox Text="{Binding CustomerName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Customer Name *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     TextChanged="CustomerName_TextChanged" />
                            <Popup IsOpen="{Binding IsCustomerDropdownOpen}" StaysOpen="False"
                                   PlacementTarget="{Binding ElementName=customerNameBox}"
                                   Placement="Bottom" Width="300">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" MaxHeight="200">
                                    <ListBox ItemsSource="{Binding CustomerSuggestions}"
                                             DisplayMemberPath="FullName"
                                             SelectionChanged="CustomerSuggestion_Selected" />
                                </Border>
                            </Popup>
                        </StackPanel>

                        <TextBox Grid.Column="1" Text="{Binding CustomerPhone}"
                                 materialDesign:HintAssist.Hint="Phone Number"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="12,0,0,0" />
                    </Grid>
                </Border>

                <!-- ══════ Order Details Section ══════ -->
                <TextBlock Text="Order Details" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,20">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DatePicker Grid.Column="0" SelectedDate="{Binding DateOrdered}"
                                    materialDesign:HintAssist.Hint="Date Ordered *"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Margin="0,0,8,0" />

                        <DatePicker Grid.Column="1" SelectedDate="{Binding DueDate}"
                                    materialDesign:HintAssist.Hint="Due Date *"
                                    Style="{StaticResource MaterialDesignOutlinedDatePicker}"
                                    Margin="8,0,8,0" />

                        <ComboBox Grid.Column="2" SelectedValue="{Binding Severity}"
                                  SelectedValuePath="Tag"
                                  materialDesign:HintAssist.Hint="Severity *"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="8,0,8,0">
                            <ComboBoxItem Content="Low" Tag="{x:Static enums:SeverityLevel.Low}" />
                            <ComboBoxItem Content="High" Tag="{x:Static enums:SeverityLevel.High}" />
                            <ComboBoxItem Content="Rush" Tag="{x:Static enums:SeverityLevel.Rush}" />
                        </ComboBox>

                        <ComboBox Grid.Column="3" SelectedValue="{Binding Status}"
                                  SelectedValuePath="Tag"
                                  materialDesign:HintAssist.Hint="Status"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="8,0,0,0">
                            <ComboBoxItem Content="Active" Tag="{x:Static enums:OrderStatus.Active}" />
                            <ComboBoxItem Content="In Progress" Tag="{x:Static enums:OrderStatus.InProgress}" />
                            <ComboBoxItem Content="Completed" Tag="{x:Static enums:OrderStatus.Completed}" />
                            <ComboBoxItem Content="Cancelled" Tag="{x:Static enums:OrderStatus.Cancelled}" />
                        </ComboBox>
                    </Grid>
                </Border>

                <!-- ══════ Order Products Section ══════ -->
                <DockPanel Margin="0,0,0,10">
                    <TextBlock Text="Products" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"
                               VerticalAlignment="Center" Margin="0" />
                    <Button DockPanel.Dock="Right" HorizontalAlignment="Right"
                            Style="{StaticResource ModernOutlinedButton}"
                            Command="{Binding OpenProductPickerCommand}" Padding="12,6">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="Plus" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,4,0" />
                            <TextBlock Text="Add Product" FontSize="12.5" />
                        </StackPanel>
                    </Button>
                </DockPanel>
                <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,20">
                    <StackPanel>
                        <!-- Empty state -->
                        <TextBlock Text="No products added. Click &quot;Add Product&quot; to select from your catalog."
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,12,0,12"
                                   Visibility="{Binding OrderItems.Count, Converter={StaticResource InverseBoolToVisibility}}" />

                        <!-- Order items list -->
                        <ItemsControl ItemsSource="{Binding OrderItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,4">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="70" />
                                                <ColumnDefinition Width="110" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="36" />
                                                <ColumnDefinition Width="36" />
                                            </Grid.ColumnDefinitions>

                                            <!-- Product thumbnail -->
                                            <Border Grid.Column="0" Width="36" Height="36" CornerRadius="6"
                                                    ClipToBounds="True" Background="{DynamicResource CardHoverBrush}"
                                                    Margin="0,0,8,0">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="PackageVariantClosed" Width="18" Height="18"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource TextMutedBrush}" />
                                                    <Image Source="{Binding ProductImagePath, Converter={StaticResource ImagePathConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <!-- Product name -->
                                            <TextBlock Grid.Column="1" Text="{Binding DisplayName}"
                                                       VerticalAlignment="Center" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- Quantity -->
                                            <TextBox Grid.Column="2" Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}"
                                                     materialDesign:HintAssist.Hint="Qty" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     TextChanged="OrderItem_Changed" />

                                            <!-- Unit Price -->
                                            <TextBox Grid.Column="3" Text="{Binding UnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                     materialDesign:HintAssist.Hint="Unit Price" Margin="0,0,8,0"
                                                     VerticalAlignment="Center"
                                                     TextChanged="OrderItem_Changed" />

                                            <!-- Line total -->
                                            <TextBlock Grid.Column="4" Text="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}"
                                                       VerticalAlignment="Center" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />

                                            <!-- Remove -->
                                            <Button Grid.Column="5" Style="{StaticResource ModernIconButtonDanger}"
                                                    Command="{Binding DataContext.RemoveOrderItemCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                            </Button>

                                            <!-- Reject -->
                                            <Button Grid.Column="6" Width="28" Height="28"
                                                    ToolTip="Reject this item"
                                                    Command="{Binding DataContext.OpenRejectDialogCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}"
                                                    Visibility="{Binding DataContext.IsNewOrder, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource InverseBoolToVisibility}}">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource ModernIconButton}">
                                                        <Setter Property="Foreground" Value="{DynamicResource RejectTextBrush}" />
                                                    </Style>
                                                </Button.Style>
                                                <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="14" Height="14" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Subtotal, Discount & Total -->
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,12,0,0" Padding="0,14,0,0"
                                Visibility="{Binding OrderItems.Count, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel HorizontalAlignment="Right" Margin="0,0,0,0">
                                <!-- Subtotal -->
                                <TextBlock FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" HorizontalAlignment="Right">
                                    <Run Text="Subtotal: " />
                                    <Run Text="{Binding SubTotal, Converter={StaticResource CurrencyConverter}, Mode=OneWay}" FontWeight="Medium" />
                                </TextBlock>

                                <!-- Discount row -->
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <TextBlock Text="Discount:" FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <ComboBox SelectedValue="{Binding DiscountType}" SelectedValuePath="Tag"
                                              Width="120" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="12">
                                        <ComboBoxItem Content="None" Tag="{x:Static enums:DiscountType.None}" />
                                        <ComboBoxItem Content="Percent (%)" Tag="{x:Static enums:DiscountType.Percentage}" />
                                        <ComboBoxItem Content="Amount (₱)" Tag="{x:Static enums:DiscountType.FixedAmount}" />
                                    </ComboBox>
                                    <TextBox Text="{Binding DiscountValue, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                             Width="90" VerticalAlignment="Center" FontSize="13"
                                             materialDesign:HintAssist.Hint="0.00"
                                             TextChanged="OrderItem_Changed" />
                                    <TextBlock FontSize="13" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"
                                               Margin="10,0,0,0"
                                               Visibility="{Binding DiscountAmount, Converter={StaticResource BoolToVisibility}}">
                                        <Run Text="-" /><Run Text="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}, Mode=OneWay}" />
                                    </TextBlock>
                                </StackPanel>

                                <!-- Total -->
                                <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right">
                                    <Run Text="Total: " FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <Run Text="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- ══════ Payment Section ══════ -->
                <TextBlock Text="Payment" Style="{StaticResource SectionTitle}" />

                <!-- ── Payment summary cards ── -->
                <Border Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!-- Payment Status -->
                        <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" CornerRadius="10" Padding="16,10" Margin="0,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Status" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" />
                                <TextBlock Text="{Binding PaymentType, Converter={StaticResource EnumDescriptionConverter}}"
                                           FontSize="15" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Auto-set by payments" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Amount Paid -->
                        <Border Grid.Column="1" Background="{DynamicResource SuccessBgBrush}" CornerRadius="10" Padding="16,10" Margin="8,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Total Paid" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" />
                                <TextBlock Text="{Binding AmountPaid, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource SuccessTextBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Sum of all payments" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Balance Due -->
                        <Border Grid.Column="2" Background="{DynamicResource DangerBgBrush}" CornerRadius="10" Padding="16,10" Margin="8,0,8,0"
                                VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock Text="Balance Due" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" FontWeight="Medium" />
                                <TextBlock Text="{Binding BalanceDue, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="18" FontWeight="Bold" Foreground="{DynamicResource DangerTextBrush}" Margin="0,2,0,0" />
                                <TextBlock Text="Order Total − Paid" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Add Payment button (existing orders only) -->
                        <Button Grid.Column="3" Style="{StaticResource ModernPrimaryButton}"
                                Command="{Binding OpenPaymentDialogCommand}"
                                Padding="14,8" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsNewOrder, Converter={StaticResource InverseBoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashPlus" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Add Payment" FontSize="13" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!-- ── New order: manual payment entry (before first save) ── -->
                <Border Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,12"
                        Visibility="{Binding IsNewOrder, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ComboBox Grid.Column="0" SelectedValue="{Binding PaymentType}"
                                  SelectedValuePath="Tag"
                                  materialDesign:HintAssist.Hint="Payment Type"
                                  Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                  Margin="0,0,8,0">
                            <ComboBoxItem Content="Unpaid" Tag="{x:Static enums:PaymentType.Unpaid}" />
                            <ComboBoxItem Content="Downpayment" Tag="{x:Static enums:PaymentType.Downpayment}" />
                            <ComboBoxItem Content="Full Payment" Tag="{x:Static enums:PaymentType.FullPayment}" />
                        </ComboBox>

                        <TextBox Grid.Column="1" Text="{Binding AmountPaid, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                 materialDesign:HintAssist.Hint="Amount Paid (₱)"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="8,0,0,0" />
                    </Grid>
                </Border>

                <!-- ── Payment History table (existing orders only) ── -->
                <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,20"
                        Visibility="{Binding IsNewOrder, Converter={StaticResource InverseBoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="Payment History" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,12" />

                        <!-- No payments placeholder -->
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="20"
                                Visibility="{Binding PaymentHistory.Count, Converter={StaticResource InverseBoolToVisibility}}"
                                Margin="0,0,0,4">
                            <StackPanel HorizontalAlignment="Center">
                                <materialDesign:PackIcon Kind="CashRemove" Width="32" Height="32"
                                                         Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                <TextBlock Text="No payments recorded yet" FontSize="13"
                                           Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <!-- Payment history DataGrid -->
                        <DataGrid ItemsSource="{Binding PaymentHistory}" AutoGenerateColumns="False"
                                  IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False"
                                  CanUserResizeColumns="True" CanUserSortColumns="True"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  Background="Transparent" BorderThickness="0"
                                  RowBackground="Transparent"
                                  AlternatingRowBackground="{DynamicResource SurfaceBrush}"
                                  Foreground="{DynamicResource TextPrimaryBrush}"
                                  materialDesign:DataGridAssist.CellPadding="12 8"
                                  Visibility="{Binding PaymentHistory.Count, Converter={StaticResource BoolToVisibility}}"
                                  MaxHeight="260">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Date" Width="160"
                                                    Binding="{Binding PaidAt, StringFormat={}{0:MMM dd, yyyy  hh:mm tt}}" />
                                <DataGridTextColumn Header="Amount" Width="130">
                                    <DataGridTextColumn.Binding>
                                        <Binding Path="Amount" Converter="{StaticResource CurrencyConverter}" />
                                    </DataGridTextColumn.Binding>
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessTextBrush}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn Header="Notes" Width="*"
                                                    Binding="{Binding Notes}" />
                                <DataGridTemplateColumn Header="" Width="50">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource ModernIconButton}"
                                                    Command="{Binding DataContext.DeletePaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="Delete payment" Width="28" Height="28">
                                                <materialDesign:PackIcon Kind="DeleteOutline" Width="15" Height="15"
                                                                         Foreground="{DynamicResource DangerBrush}" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </Border>

                <!-- ══════ Notes ══════ -->
                <TextBlock Text="Notes / Remarks" Style="{StaticResource SectionTitle}" />
                <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,24">
                    <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="80" MaxHeight="200" />
                </Border>

                <!-- ══════ Action Buttons ══════ -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                    <Button Style="{StaticResource ModernOutlinedButton}"
                            Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="20,10">
                        <TextBlock Text="Cancel" />
                    </Button>
                    <Button Style="{StaticResource ModernPrimaryButton}"
                            Command="{Binding SaveOrderCommand}" Padding="20,10">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ContentSaveOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock Text="Save Order" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ══════ Product Picker Overlay ══════ -->
        <Border Background="#80000000"
                Visibility="{Binding IsProductPickerOpen, Converter={StaticResource BoolToVisibility}}"
                MouseLeftButtonDown="ProductPickerOverlay_Click">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
                    MaxWidth="750" MaxHeight="600" Margin="40"
                    VerticalAlignment="Center" HorizontalAlignment="Center"
                    MouseLeftButtonDown="ProductPickerCard_Click">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" />
                </Border.Effect>
                <DockPanel Margin="24">
                    <!-- Header -->
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,16">
                        <TextBlock Text="Select a Product" FontSize="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" DockPanel.Dock="Left" VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right" Style="{StaticResource ModernIconButton}"
                                Command="{Binding CloseProductPickerCommand}" HorizontalAlignment="Right"
                                Width="32" Height="32">
                            <materialDesign:PackIcon Kind="Close" Width="18" Height="18" />
                        </Button>
                    </DockPanel>

                    <!-- Search -->
                    <TextBox DockPanel.Dock="Top"
                             Text="{Binding ProductSearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=300}"
                             materialDesign:HintAssist.Hint="Search products..."
                             materialDesign:TextFieldAssist.HasLeadingIcon="True"
                             materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,16" />

                    <!-- Product grid -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding AvailableProducts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="200" Margin="0,0,12,12" Cursor="Hand"
                                            Background="{DynamicResource SurfaceBrush}" CornerRadius="10"
                                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Border.InputBindings>
                                            <MouseBinding MouseAction="LeftClick"
                                                          Command="{Binding DataContext.SelectProductCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                          CommandParameter="{Binding}" />
                                        </Border.InputBindings>
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Style.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter Property="BorderBrush" Value="{DynamicResource PrimaryBrush}" />
                                                        <Setter Property="BorderThickness" Value="2" />
                                                    </Trigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="120" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Border Grid.Row="0" CornerRadius="10,10,0,0" ClipToBounds="True"
                                                    Background="{DynamicResource CardHoverBrush}">
                                                <Grid>
                                                    <materialDesign:PackIcon Kind="ImageOutline" Width="36" Height="36"
                                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource TextMutedBrush}" />
                                                    <Image Source="{Binding ImagePath, Converter={StaticResource ImagePathConverter}}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Row="1" Margin="12,8,12,10">
                                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding DefaultPrice, Converter={StaticResource CurrencyConverter}}"
                                                           FontSize="14" FontWeight="Bold"
                                                           Foreground="{DynamicResource PrimaryBrush}" Margin="0,2,0,0" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- ══════ Reject Item Overlay ══════ -->
        <Border Background="#80000000"
                Visibility="{Binding IsRejectDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
                    MaxWidth="460" Margin="40" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="22" Height="22"
                                                 Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Reject Order Item" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap">
                        <Run Text="Rejecting" />
                        <Run Text="{Binding RejectTargetItem.ProductName, Mode=OneWay}" FontWeight="SemiBold" />
                        <Run Text="will deduct BOM materials from inventory." />
                    </TextBlock>

                    <!-- Error -->
                    <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding RejectErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding RejectErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>

                    <!-- Quantity -->
                    <TextBox Text="{Binding RejectQuantity, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Reject Quantity *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,14" />

                    <!-- Reason -->
                    <ComboBox SelectedValue="{Binding RejectReason}" SelectedValuePath="Tag"
                              materialDesign:HintAssist.Hint="Reject Reason *"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              Margin="0,0,0,14">
                        <ComboBoxItem Content="Wrong Printing" Tag="{x:Static enums:RejectReason.WrongPrinting}" />
                        <ComboBoxItem Content="Incorrect Design" Tag="{x:Static enums:RejectReason.IncorrectDesign}" />
                        <ComboBoxItem Content="Material Defect" Tag="{x:Static enums:RejectReason.MaterialDefect}" />
                        <ComboBoxItem Content="Machine Malfunction" Tag="{x:Static enums:RejectReason.MachineMalfunction}" />
                        <ComboBoxItem Content="Customer Return" Tag="{x:Static enums:RejectReason.CustomerReturn}" />
                        <ComboBoxItem Content="Quality Control" Tag="{x:Static enums:RejectReason.QualityControl}" />
                        <ComboBoxItem Content="Other" Tag="{x:Static enums:RejectReason.Other}" />
                    </ComboBox>

                    <!-- Notes -->
                    <TextBox Text="{Binding RejectNotes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Notes (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernOutlinedButton}"
                                Command="{Binding CloseRejectDialogCommand}" Padding="16,8" Margin="0,0,10,0">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource ModernPrimaryButton}"
                                Command="{Binding SubmitRejectCommand}" Padding="16,8"
                                Background="{DynamicResource DangerBrush}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="AlertOctagonOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Reject" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <!-- ══════ Add Payment Overlay ══════ -->
        <Border Background="#80000000"
                Visibility="{Binding IsPaymentDialogOpen, Converter={StaticResource BoolToVisibility}}">
            <Border Background="{DynamicResource CardBrush}" CornerRadius="16"
                    MaxWidth="440" Margin="40" Padding="28"
                    VerticalAlignment="Center" HorizontalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" Opacity="0.3" ShadowDepth="4" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <materialDesign:PackIcon Kind="CashPlus" Width="22" Height="22"
                                                 Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Text="Record Payment" FontSize="18" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock FontSize="13" Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,18" TextWrapping="Wrap">
                        <Run Text="Add a payment to this order. Balance remaining:" />
                        <Run Text="{Binding BalanceDue, Converter={StaticResource CurrencyConverter}, Mode=OneWay}" FontWeight="SemiBold" />
                    </TextBlock>

                    <!-- Error -->
                    <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="8" Padding="12,8" Margin="0,0,0,14"
                            Visibility="{Binding PaymentErrorMessage, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{Binding PaymentErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="12.5" TextWrapping="Wrap" />
                    </Border>

                    <!-- Amount -->
                    <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                             materialDesign:HintAssist.Hint="Payment Amount (₱) *"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,0,0,14" />

                    <!-- Notes -->
                    <TextBox Text="{Binding PaymentNotes, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Notes (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                             Margin="0,0,0,20" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource ModernOutlinedButton}"
                                Command="{Binding ClosePaymentDialogCommand}" Padding="16,8" Margin="0,0,10,0">
                            <TextBlock Text="Cancel" />
                        </Button>
                        <Button Style="{StaticResource ModernPrimaryButton}"
                                Command="{Binding SubmitPaymentCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="CashCheck" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Record Payment" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
