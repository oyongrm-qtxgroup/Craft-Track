<UserControl x:Class="CraftTrack.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CraftTrack.Converters"
             xmlns:vm="clr-namespace:CraftTrack.ViewModels">

    <UserControl.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Loading overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
              Panel.ZIndex="10" Background="{DynamicResource LoadingOverlayBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource ModernSpinner}" />
                <TextBlock Text="Loading dashboard..." Margin="0,14,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <DockPanel>
            <!-- ══════ Header + Period Selector ══════ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,20">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="This Month" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                            Command="{Binding SetPeriodCommand}" CommandParameter="ThisMonth" FontSize="11" />
                    <Button Content="Last Month" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                            Command="{Binding SetPeriodCommand}" CommandParameter="LastMonth" FontSize="11" />
                    <Button Content="3 Months" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                            Command="{Binding SetPeriodCommand}" CommandParameter="Last3Months" FontSize="11" />
                    <Button Content="6 Months" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                            Command="{Binding SetPeriodCommand}" CommandParameter="Last6Months" FontSize="11" />
                    <Button Content="This Year" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                            Command="{Binding SetPeriodCommand}" CommandParameter="ThisYear" FontSize="11" />
                    <Button Content="All Time" Style="{StaticResource ModernOutlinedButton}" Padding="10,6"
                            Command="{Binding SetPeriodCommand}" CommandParameter="AllTime" FontSize="11" />
                </StackPanel>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ══════ Operational Alert Cards ══════ -->
                    <UniformGrid Columns="4" Margin="0,0,0,16">
                        <!-- Active Orders -->
                        <Border Style="{StaticResource StatCard}" Margin="0,0,14,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="ACTIVE ORDERS" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding ActiveOrderCount}" Style="{StaticResource StatNumber}"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="Active + In Progress orders" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource StatIconBg1}" CornerRadius="10" Width="42" Height="42"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="ClipboardTextOutline" Width="22" Height="22"
                                                             Foreground="{DynamicResource StatIconFg1}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Rush / High Priority -->
                        <Border Style="{StaticResource StatCard}" Margin="7,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="RUSH / HIGH" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding RushHighPriorityCount}" Style="{StaticResource StatNumber}"
                                               Foreground="{DynamicResource WarningBrush}" />
                                    <TextBlock Text="Rush or High priority" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource StatIconBg2}" CornerRadius="10" Width="42" Height="42"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="AlertCircleOutline" Width="22" Height="22"
                                                             Foreground="{DynamicResource StatIconFg2}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Overdue -->
                        <Border Style="{StaticResource StatCard}" Margin="7,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="OVERDUE" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding OverdueOrderCount}" Style="{StaticResource StatNumber}"
                                               Foreground="{DynamicResource DangerBrush}" />
                                    <TextBlock Text="Past due date" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource StatIconBg3}" CornerRadius="10" Width="42" Height="42"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="ClockAlertOutline" Width="22" Height="22"
                                                             Foreground="{DynamicResource StatIconFg3}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>

                        <!-- Low Stock -->
                        <Border Style="{StaticResource StatCard}" Margin="14,0,0,0">
                            <Grid>
                                <StackPanel>
                                    <TextBlock Text="LOW STOCK" Style="{StaticResource StatLabel}" />
                                    <TextBlock Text="{Binding LowStockCount}" Style="{StaticResource StatNumber}"
                                               Foreground="{DynamicResource StatIconFg4}" />
                                    <TextBlock Text="Stock ≤ min. threshold" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <Border Background="{DynamicResource StatIconBg4}" CornerRadius="10" Width="42" Height="42"
                                        HorizontalAlignment="Right" VerticalAlignment="Top">
                                    <materialDesign:PackIcon Kind="PackageVariantRemove" Width="22" Height="22"
                                                             Foreground="{DynamicResource StatIconFg4}"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </UniformGrid>

                    <!-- ══════ Financial KPI Cards — Row 1 ══════ -->
                    <UniformGrid Columns="3" Margin="0,0,0,12">
                        <!-- Revenue -->
                        <Border CornerRadius="14" Padding="20,16" Margin="0,0,10,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource RevenueGradient}">
                            <StackPanel>
                                <TextBlock Text="TOTAL REVENUE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource RevenueSubtitleBrush}" />
                                <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Sum of all order totals" FontSize="9"
                                           Foreground="{DynamicResource RevenueSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Total Orders -->
                        <Border CornerRadius="14" Padding="20,16" Margin="5,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource ProfitGradient}">
                            <StackPanel>
                                <TextBlock Text="TOTAL ORDERS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ProfitSubtitleBrush}" />
                                <TextBlock Text="{Binding TotalOrders}"
                                           FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock FontSize="9" Foreground="{DynamicResource ProfitSubtitleBrush}" Margin="0,2,0,0">
                                    <TextBlock.Text>
                                        <MultiBinding StringFormat="Avg: {0}">
                                            <Binding Path="AverageOrderValue" Converter="{StaticResource CurrencyConverter}" />
                                        </MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <!-- Net Profit -->
                        <Border CornerRadius="14" Padding="20,16" Margin="10,0,0,0"
                                Effect="{StaticResource CardShadow}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource PLRevenueGradient}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProfitPositive}" Value="False">
                                            <Setter Property="Background" Value="{DynamicResource PLExpenseGradient}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel>
                                <TextBlock Text="NET PROFIT" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OverlayTextBrush}" />
                                <TextBlock Text="{Binding NetProfit, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="24" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Revenue − Expenses" FontSize="9"
                                           Foreground="{DynamicResource OverlayTextBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ══════ Financial KPI Cards — Row 2 ══════ -->
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <!-- Expenses -->
                        <Border CornerRadius="14" Padding="20,16" Margin="0,0,10,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource ExpenseGradient}">
                            <StackPanel>
                                <TextBlock Text="TOTAL EXPENSES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ExpenseSubtitleBrush}" />
                                <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="All business expenses" FontSize="9"
                                           Foreground="{DynamicResource ExpenseSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Outstanding -->
                        <Border CornerRadius="14" Padding="20,16" Margin="5,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource OutstandingGradient}">
                            <StackPanel>
                                <TextBlock Text="OUTSTANDING" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OutstandingSubtitleBrush}" />
                                <TextBlock Text="{Binding OutstandingBalance, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="∑ (Order Total − Paid)" FontSize="9"
                                           Foreground="{DynamicResource OutstandingSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Rejection Losses -->
                        <Border CornerRadius="14" Padding="20,16" Margin="5,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource RejectGradient}">
                            <StackPanel>
                                <TextBlock Text="REJECTION LOSSES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="#FECACA" />
                                <TextBlock Text="{Binding RejectionLosses, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="{Binding RejectCount, StringFormat='{}{0} rejected × material cost'}" FontSize="9"
                                           Foreground="#FECACA" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Products -->
                        <Border CornerRadius="14" Padding="20,16" Margin="10,0,0,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource ProfitGradient}">
                            <StackPanel>
                                <TextBlock Text="PRODUCTS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ProfitSubtitleBrush}" />
                                <TextBlock Text="{Binding ProductCount}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Listed in catalog" FontSize="9"
                                           Foreground="{DynamicResource ProfitSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ══════ Order Status Breakdown Cards ══════ -->
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <Border Style="{StaticResource StatCard}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Text="ACTIVE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusBreakdown, Converter={StaticResource StatusCountConverter}, ConverterParameter=Active, FallbackValue=0}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="Placed, not started" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="IN PROGRESS" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusBreakdown, Converter={StaticResource StatusCountConverter}, ConverterParameter=InProgress, FallbackValue=0}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="Production underway" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="5,0">
                            <StackPanel>
                                <TextBlock Text="COMPLETED" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusBreakdown, Converter={StaticResource StatusCountConverter}, ConverterParameter=Completed, FallbackValue=0}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource SuccessBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="Finished &amp; delivered" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource StatCard}" Margin="10,0,0,0">
                            <StackPanel>
                                <TextBlock Text="CANCELLED" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}" />
                                <TextBlock Text="{Binding StatusBreakdown, Converter={StaticResource StatusCountConverter}, ConverterParameter=Cancelled, FallbackValue=0}"
                                           FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                                <TextBlock Text="Won't be fulfilled" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ══════ Revenue vs Expenses Period Table Card ══════ -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20"
                            Visibility="{Binding MonthlyData.Count, Converter={StaticResource IntToBoolToVisibility}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="Revenue vs Expenses by Period" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <DataGrid ItemsSource="{Binding MonthlyData}" AutoGenerateColumns="False"
                                      Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                      ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      MaxHeight="280">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Period" Binding="{Binding Month}" Width="*" />
                                    <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, Converter={StaticResource CurrencyConverter}}" Width="130" />
                                    <DataGridTextColumn Header="Expenses" Binding="{Binding Expenses, Converter={StaticResource CurrencyConverter}}" Width="130" />
                                    <DataGridTemplateColumn Header="Profit" Width="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock FontWeight="SemiBold" VerticalAlignment="Center">
                                                    <TextBlock.Text>
                                                        <MultiBinding StringFormat="{}{0:C}">
                                                            <Binding Path="Profit" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Value="True">
                                                                    <DataTrigger.Binding>
                                                                        <Binding Path="Profit" Converter="{StaticResource InverseBoolConverter}" />
                                                                    </DataTrigger.Binding>
                                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <!-- ══════ Top Products + Top Customers ══════ -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Top Products -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Top Selling Products" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding TopProducts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="60" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ProductName}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding QuantitySold, StringFormat='{}{0} sold'}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Revenue, Converter={StaticResource CurrencyConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No products sold in this period" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding TopProducts.Count, Converter={StaticResource IntToZeroVisibility}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>

                        <!-- Top Customers -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Top Customers by Revenue" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <ItemsControl ItemsSource="{Binding TopCustomers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="70" />
                                                    <ColumnDefinition Width="90" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding CustomerName}" FontSize="12" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="1" Text="{Binding OrderCount, StringFormat='{}{0} orders'}"
                                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                                <TextBlock Grid.Column="2" Text="{Binding Revenue, Converter={StaticResource CurrencyConverter}}"
                                                           FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"
                                                           VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Text="No customer data in this period" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0"
                                           Visibility="{Binding TopCustomers.Count, Converter={StaticResource IntToZeroVisibility}, FallbackValue=Collapsed}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══════ Expense Category Breakdown ══════ -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20"
                            Visibility="{Binding ExpenseCategoryBreakdown.Count, Converter={StaticResource IntToBoolToVisibility}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="Expense Breakdown by Category" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding ExpenseCategoryBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Category, Converter={StaticResource ExpenseCategoryColorConverter}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Height="8" CornerRadius="4" Margin="8,0"
                                                    Background="{DynamicResource ChartBarTrack}">
                                                <Border CornerRadius="4" HorizontalAlignment="Left"
                                                        Width="{Binding Percentage, Converter={StaticResource DecimalToBarWidth}}"
                                                        Background="{Binding Category, Converter={StaticResource ExpenseCategoryColorConverter}}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Percentage, StringFormat={}{0:N1}%}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ══════ Quick Actions + Income Records ══════ -->
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Quick Actions -->
                        <Border Grid.Column="0" Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Quick Actions" FontSize="15" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                                <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddNewOrderCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="New Order" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddNewProductCommand}"
                                        HorizontalAlignment="Stretch" Margin="0,0,0,10"
                                        Background="{DynamicResource AccentBrush}" BorderBrush="{DynamicResource AccentBrush}">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="New Product" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ModernOutlinedButton}" Command="{Binding AddInventoryItemCommand}"
                                        HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                                        <TextBlock Text="Inventory Item" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Income Records -->
                        <Border Grid.Column="2" Style="{StaticResource ModernCard}">
                            <StackPanel>
                                <TextBlock Text="Income Records" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                                <DataGrid ItemsSource="{Binding IncomeRecords}" AutoGenerateColumns="False"
                                          Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                          CellStyle="{StaticResource ModernDataGridCell}"
                                          RowStyle="{StaticResource ModernDataGridRow}"
                                          MaxHeight="280">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order #" Binding="{Binding Id}" Width="70" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.FullName}" Width="*" />
                                        <DataGridTextColumn Header="Date" Binding="{Binding DateOrdered, StringFormat={}{0:MMM dd}}" Width="80" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="100" />
                                        <DataGridTextColumn Header="Payment" Binding="{Binding PaymentType, Converter={StaticResource EnumDescriptionConverter}}" Width="90" />
                                        <DataGridTemplateColumn Header="" Width="50">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource ModernIconButton}" ToolTip="View Order"
                                                            Command="{Binding DataContext.ViewOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="ArrowRight" Width="16" Height="16" />
                                                    </Button>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- ══════ Two-Column: Deadlines + Recent Orders ══════ -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Upcoming Deadlines -->
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Upcoming Deadlines" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource ModernCard}" Padding="0">
                                <DataGrid ItemsSource="{Binding UpcomingDeadlines}"
                                          Style="{StaticResource ModernDataGrid}"
                                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                          CellStyle="{StaticResource ModernDataGridCell}"
                                          RowStyle="{StaticResource ModernDataGridRow}"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order #" Binding="{Binding Id}" Width="70" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.FullName}" Width="*" />
                                        <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=MMM d}" Width="70" />
                                        <DataGridTemplateColumn Header="" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityColorConverter}}"
                                                            Style="{StaticResource Pill}">
                                                        <TextBlock Text="{Binding Severity}" Style="{StaticResource PillText}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>

                        <!-- Recent Orders -->
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Recent Orders" Style="{StaticResource SectionTitle}" />
                            <Border Style="{StaticResource ModernCard}" Padding="0">
                                <DataGrid ItemsSource="{Binding RecentOrders}"
                                          Style="{StaticResource ModernDataGrid}"
                                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                          CellStyle="{StaticResource ModernDataGridCell}"
                                          RowStyle="{StaticResource ModernDataGridRow}"
                                          MaxHeight="300">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Order #" Binding="{Binding Id}" Width="70" />
                                        <DataGridTextColumn Header="Customer" Binding="{Binding Customer.FullName}" Width="*" />
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="90" />
                                        <DataGridTemplateColumn Header="" Width="60">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding PaymentType, Converter={StaticResource PaymentColorConverter}}"
                                                            Style="{StaticResource Pill}">
                                                        <TextBlock Text="{Binding PaymentType}" Style="{StaticResource PillText}" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Grid>
</UserControl>
