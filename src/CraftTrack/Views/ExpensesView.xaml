<UserControl x:Class="CraftTrack.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CraftTrack.Converters"
             xmlns:vm="clr-namespace:CraftTrack.ViewModels">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <!-- Loading overlay -->
        <Grid Visibility="{Binding IsLoading, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
              Panel.ZIndex="10" Background="{DynamicResource LoadingOverlayBrush}">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <ProgressBar Style="{StaticResource ModernSpinner}" />
                <TextBlock Text="Loading expenses..." Margin="0,14,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13" HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>

        <DockPanel>
            <!-- ══════ Header + Period Selector ══════ -->
            <Border DockPanel.Dock="Top" Margin="0,0,0,20">
                <Grid>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Button Style="{StaticResource ModernPrimaryButton}" Padding="14,8"
                                Command="{Binding OpenAddExpenseCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" />
                                <TextBlock Text="Add Expense" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="This Month" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                                Command="{Binding SetPeriodCommand}" CommandParameter="ThisMonth" FontSize="11" />
                        <Button Content="Last Month" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                                Command="{Binding SetPeriodCommand}" CommandParameter="LastMonth" FontSize="11" />
                        <Button Content="3 Months" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                                Command="{Binding SetPeriodCommand}" CommandParameter="Last3Months" FontSize="11" />
                        <Button Content="6 Months" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                                Command="{Binding SetPeriodCommand}" CommandParameter="Last6Months" FontSize="11" />
                        <Button Content="This Year" Style="{StaticResource ModernOutlinedButton}" Padding="10,6" Margin="0,0,4,0"
                                Command="{Binding SetPeriodCommand}" CommandParameter="ThisYear" FontSize="11" />
                        <Button Content="All Time" Style="{StaticResource ModernOutlinedButton}" Padding="10,6"
                                Command="{Binding SetPeriodCommand}" CommandParameter="AllTime" FontSize="11" />
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- ══════ Summary Cards ══════ -->
                    <UniformGrid Columns="4" Margin="0,0,0,20">
                        <!-- Total Expenses -->
                        <Border CornerRadius="14" Padding="20,16" Margin="0,0,10,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource ExpenseGradient}">
                            <StackPanel>
                                <TextBlock Text="TOTAL EXPENSES" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ExpenseSubtitleBrush}" />
                                <TextBlock Text="{Binding TotalExpenses, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Sum of all expenses" FontSize="9"
                                           Foreground="{DynamicResource ExpenseSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Expense Count -->
                        <Border CornerRadius="14" Padding="20,16" Margin="5,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource ProfitGradient}">
                            <StackPanel>
                                <TextBlock Text="EXPENSE COUNT" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource ProfitSubtitleBrush}" />
                                <TextBlock Text="{Binding ExpenseCount}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Individual records" FontSize="9"
                                           Foreground="{DynamicResource ProfitSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Average -->
                        <Border CornerRadius="14" Padding="20,16" Margin="5,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource RevenueGradient}">
                            <StackPanel>
                                <TextBlock Text="AVERAGE" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource RevenueSubtitleBrush}" />
                                <TextBlock Text="{Binding AverageExpense, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Total ÷ Count" FontSize="9"
                                           Foreground="{DynamicResource RevenueSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <!-- Largest -->
                        <Border CornerRadius="14" Padding="20,16" Margin="10,0,0,0"
                                Effect="{StaticResource CardShadow}" Background="{DynamicResource OutstandingGradient}">
                            <StackPanel>
                                <TextBlock Text="LARGEST" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource OutstandingSubtitleBrush}" />
                                <TextBlock Text="{Binding LargestExpense, Converter={StaticResource CurrencyConverter}}"
                                           FontSize="22" FontWeight="Bold" Foreground="White" Margin="0,4,0,0" />
                                <TextBlock Text="Highest single expense" FontSize="9"
                                           Foreground="{DynamicResource OutstandingSubtitleBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <!-- ══════ Category Breakdown ══════ -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20"
                            Visibility="{Binding ExpenseCategoryBreakdown.Count, Converter={StaticResource IntToBoolToVisibility}, FallbackValue=Collapsed}">
                        <StackPanel>
                            <TextBlock Text="Breakdown by Category" Style="{StaticResource SectionTitle}" Margin="0,0,0,12" />
                            <ItemsControl ItemsSource="{Binding ExpenseCategoryBreakdown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="24" />
                                                <ColumnDefinition Width="100" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="90" />
                                                <ColumnDefinition Width="60" />
                                            </Grid.ColumnDefinitions>
                                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                                     Fill="{Binding Category, Converter={StaticResource ExpenseCategoryColorConverter}}" />
                                            <TextBlock Grid.Column="1" Text="{Binding CategoryName}" FontSize="12" FontWeight="Medium"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                            <Border Grid.Column="2" Height="8" CornerRadius="4" Margin="8,0"
                                                    Background="{DynamicResource ChartBarTrack}">
                                                <Border CornerRadius="4" HorizontalAlignment="Left"
                                                        Width="{Binding Percentage, Converter={StaticResource DecimalToBarWidth}}"
                                                        Background="{Binding Category, Converter={StaticResource ExpenseCategoryColorConverter}}" />
                                            </Border>
                                            <TextBlock Grid.Column="3" Text="{Binding Amount, Converter={StaticResource CurrencyConverter}}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                            <TextBlock Grid.Column="4" Text="{Binding Percentage, StringFormat={}{0:N1}%}"
                                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center" HorizontalAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- ══════ Expense Records ══════ -->
                    <Border Style="{StaticResource ModernCard}" Margin="0,0,0,20">
                        <StackPanel>
                            <Grid Margin="0,0,0,12">
                                <TextBlock Text="Expense Records" Style="{StaticResource SectionTitle}"
                                           VerticalAlignment="Center" />
                                <ComboBox Width="160" HorizontalAlignment="Right" VerticalAlignment="Center"
                                          materialDesign:HintAssist.Hint="Filter by category"
                                          SelectedItem="{Binding SelectedExpenseCategory, Mode=TwoWay}"
                                          ItemsSource="{Binding AllExpenseCategories}"
                                          Style="{StaticResource MaterialDesignOutlinedComboBox}"
                                          Padding="8,4" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </Grid>

                            <DataGrid ItemsSource="{Binding Expenses}" AutoGenerateColumns="False"
                                      Style="{StaticResource ModernDataGrid}" IsReadOnly="True"
                                      ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                                      CellStyle="{StaticResource ModernDataGridCell}"
                                      RowStyle="{StaticResource ModernDataGridRow}"
                                      MaxHeight="500">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat={}{0:MMM dd, yyyy}}" Width="120" />
                                    <DataGridTextColumn Header="Category" Binding="{Binding Category, Converter={StaticResource EnumDescriptionConverter}}" Width="120" />
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Converter={StaticResource CurrencyConverter}}" Width="110" />
                                    <DataGridTextColumn Header="Order" Binding="{Binding Order.Id, StringFormat='#{0}', TargetNullValue='-'}" Width="70" />
                                    <DataGridTemplateColumn Header="Actions" Width="90">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Button Style="{StaticResource ModernIconButton}" ToolTip="Edit"
                                                            Command="{Binding DataContext.OpenEditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Pencil" Width="15" Height="15" />
                                                    </Button>
                                                    <Button Style="{StaticResource ModernIconButtonDanger}" ToolTip="Delete" Margin="4,0,0,0"
                                                            Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}">
                                                        <materialDesign:PackIcon Kind="Delete" Width="15" Height="15" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </DockPanel>

        <!-- ══════ Expense Form Dialog Overlay ══════ -->
        <Grid Visibility="{Binding IsExpenseFormOpen, Converter={StaticResource BoolToVisibility}, FallbackValue=Collapsed}"
              Panel.ZIndex="20" Background="#80000000">
            <Border Style="{StaticResource ModernCard}" Width="420" VerticalAlignment="Center" HorizontalAlignment="Center"
                    Padding="28,24">
                <StackPanel>
                    <TextBlock FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Add Expense" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditingExpense}" Value="True">
                                        <Setter Property="Text" Value="Edit Expense" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <DatePicker SelectedDate="{Binding ExpenseFormDate}"
                                materialDesign:HintAssist.Hint="Date"
                                Style="{StaticResource MaterialDesignOutlinedDatePicker}" Margin="0,0,0,12" />

                    <ComboBox ItemsSource="{Binding AllExpenseCategories}"
                              SelectedItem="{Binding ExpenseFormCategory}"
                              materialDesign:HintAssist.Hint="Category"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}" Margin="0,0,0,12">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource EnumDescriptionConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBox Text="{Binding ExpenseFormDescription, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Description (optional)"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                    <TextBox Text="{Binding ExpenseFormAmount, UpdateSourceTrigger=PropertyChanged}"
                             materialDesign:HintAssist.Hint="Amount"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}" Margin="0,0,0,12" />

                    <!-- Error -->
                    <TextBlock Text="{Binding ExpenseFormError}" Foreground="{DynamicResource DangerBrush}" FontSize="12"
                               Margin="0,0,0,12"
                               Visibility="{Binding ExpenseFormError, Converter={StaticResource StringToVisibility}, FallbackValue=Collapsed}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                        <Button Content="Cancel" Style="{StaticResource ModernOutlinedButton}" Padding="16,8"
                                Command="{Binding CancelExpenseFormCommand}" Margin="0,0,10,0" />
                        <Button Content="Save" Style="{StaticResource ModernPrimaryButton}" Padding="16,8"
                                Command="{Binding SaveExpenseCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
