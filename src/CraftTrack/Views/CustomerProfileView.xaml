<UserControl x:Class="CraftTrack.Views.CustomerProfileView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel MaxWidth="920" Margin="0,0,0,32">
            <!-- Back Button -->
            <Button Style="{StaticResource ModernOutlinedButton}" HorizontalAlignment="Left" Margin="0,0,0,16"
                    Command="{Binding GoBackCommand}" Padding="12,6">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="ArrowLeft" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBlock Text="Back to Customers" FontSize="12.5" />
                </StackPanel>
            </Button>

            <!-- ══════ Customer Info ══════ -->
            <Border Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,20">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Full Name"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 IsReadOnly="{Binding IsEditing, Converter={StaticResource InverseBoolConverter}}"
                                 Margin="0,0,0,12" />

                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Phone"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 Margin="0,0,0,12" />

                        <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                 materialDesign:HintAssist.Hint="Notes"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="24,0,0,0" VerticalAlignment="Top">
                        <Button Style="{StaticResource ModernOutlinedButton}"
                                Command="{Binding ToggleEditCommand}" Margin="0,0,0,8" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="PencilOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Edit" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernPrimaryButton}"
                                Command="{Binding SaveCustomerCommand}" Padding="16,8">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="ContentSaveOutline" Width="15" Height="15" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══════ Financial Summary ══════ -->
            <UniformGrid Columns="2" Margin="0,0,0,20">
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24" Margin="0,0,10,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource RevenueCardBgBrush}" CornerRadius="8" Width="36" Height="36">
                                <materialDesign:PackIcon Kind="TrendingUp" Width="18" Height="18"
                                                         Foreground="{DynamicResource RevenueCardFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Total Revenue" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding TotalRevenue, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource RevenueCardFgBrush}" />
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource CardBrush}" CornerRadius="12" Padding="24" Margin="10,0,0,0"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.06" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <Border Background="{DynamicResource BalanceCardBgBrush}" CornerRadius="8" Width="36" Height="36">
                                <materialDesign:PackIcon Kind="AlertCircleOutline" Width="18" Height="18"
                                                         Foreground="{DynamicResource BalanceCardFgBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="Outstanding Balance" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding OutstandingBalance, Converter={StaticResource CurrencyConverter}}"
                                   FontSize="26" FontWeight="Bold" Foreground="{DynamicResource BalanceCardFgBrush}" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════ Order History ══════ -->
            <TextBlock Text="Order History" Style="{StaticResource SectionTitle}" />
            <Border Style="{StaticResource ModernCard}" Padding="0">
                <DataGrid ItemsSource="{Binding Orders}"
                          Style="{StaticResource ModernDataGrid}"
                          ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                          CellStyle="{StaticResource ModernDataGridCell}"
                          RowStyle="{StaticResource ModernDataGridRow}"
                          MaxHeight="400"
                          MouseDoubleClick="OrderGrid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Order #" Binding="{Binding Id}" Width="70" />
                        <DataGridTextColumn Header="Date" Binding="{Binding DateOrdered, StringFormat=d}" Width="100" />
                        <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=d}" Width="100" />
                        <DataGridTemplateColumn Header="Severity" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityColorConverter}}"
                                            Style="{StaticResource Pill}">
                                        <TextBlock Text="{Binding Severity}" Style="{StaticResource PillText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="100" />
                        <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, Converter={StaticResource CurrencyConverter}}" Width="100" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
