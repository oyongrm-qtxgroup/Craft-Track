<Window x:Class="CraftTrack.Views.SetupWizardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        xmlns:models="clr-namespace:CraftTrack.Models"
        mc:Ignorable="d"
        Title="Craft Track Setup"
        Icon="pack://application:,,,/Craft%20Track%20(Icon).ico"
        Width="520"
        Height="620"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="Transparent"
        AllowsTransparency="True"
        ShowInTaskbar="True">

    <Border Background="White" CornerRadius="12" BorderThickness="1" BorderBrush="#1A000000" Padding="24">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="8" Opacity="0.22" Color="#33000000" />
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="0">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="1">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Ellipse Width="10" Height="10" Margin="0,0,8,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="2">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <Ellipse Width="10" Height="10">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#D1D5DB" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentStep}" Value="3">
                                        <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                </StackPanel>

                <Button Grid.Column="1"
                        Width="28"
                        Height="28"
                        Padding="0"
                        BorderThickness="0"
                        Background="Transparent"
                        Foreground="#6B7280"
                        FontSize="16"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Content="X"
                        ToolTip="Close"
                        Style="{x:Null}"
                        Click="CloseButton_Click" />
            </Grid>

            <TabControl Grid.Row="1"
                        SelectedIndex="{Binding CurrentStep}"
                        BorderThickness="0"
                        Background="Transparent">
                <TabControl.Resources>
                    <Style TargetType="TabItem">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </Style>
                </TabControl.Resources>

                <TabItem>
                    <Grid>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="380">
                            <Border Width="88" Height="88" CornerRadius="44" Background="#F3F4F6" Margin="0,0,0,18">
                                <Image Source="pack://application:,,,/Assets/Craft%20Track%20(Icon).png" Stretch="Uniform" Margin="14" />
                            </Border>
                            <TextBlock Text="Welcome to Craft Track"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="#111827"
                                       TextAlignment="Center" />
                            <TextBlock Text="Set up your business branding and theme in a few quick steps."
                                       Margin="0,14,0,0"
                                       FontSize="14"
                                       Foreground="#6B7280"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Set Up Your Business" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="Customize store name, description, and sidebar logo (PNG)."
                                       Margin="0,8,0,20"
                                       Foreground="#6B7280" />

                            <TextBlock Text="Store Name" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                            <TextBox Text="{Binding AppName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12" />

                            <TextBlock Text="Description" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,6" />
                            <TextBox Text="{Binding AppSubtitle, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16" />

                            <TextBlock Text="Sidebar Logo (PNG)" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8" />
                            <DockPanel Margin="0,0,0,16">
                                <Button Content="Browse PNG"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ModernOutlinedButton}"
                                        Command="{Binding BrowseLogoCommand}"
                                        Padding="12,8"
                                        Margin="12,0,0,0" />
                                <Border Width="56" Height="56" CornerRadius="28" Background="#F3F4F6" BorderBrush="#E5E7EB" BorderThickness="1">
                                    <Image Source="{Binding LogoPreview}" Stretch="UniformToFill" />
                                </Border>
                            </DockPanel>
                            <TextBlock Text="{Binding LogoPngPath}" Foreground="#6B7280" FontSize="12" Margin="0,0,0,14" TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Text="Pick a Theme" FontSize="24" FontWeight="Bold" Foreground="#111827" />
                            <TextBlock Text="Choose your preferred appearance and accent preset."
                                       Margin="0,8,0,20"
                                       Foreground="#6B7280" />

                            <UniformGrid Columns="3" Margin="0,0,0,18">
                                <Border Margin="0,0,8,0" Padding="12" CornerRadius="10" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="#E5E7EB"
                                        Background="#F9FAFB">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding SetThemeCommand}"
                                                      CommandParameter="{x:Static models:ThemeMode.Light}" />
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                                            <Setter Property="Background" Value="#F9FAFB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.Light}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="#EEF4FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                 Width="16"
                                                                 Height="16"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="{DynamicResource AccentBrush}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.Light}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="26" Height="26" Foreground="#F59E0B" />
                                            <TextBlock Text="Light" Margin="0,6,0,0" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Margin="4,0" Padding="12" CornerRadius="10" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="#E5E7EB"
                                        Background="#F9FAFB">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding SetThemeCommand}"
                                                      CommandParameter="{x:Static models:ThemeMode.Dark}" />
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                                            <Setter Property="Background" Value="#F9FAFB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.Dark}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="#EEF4FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                 Width="16"
                                                                 Height="16"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="{DynamicResource AccentBrush}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.Dark}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="MoonWaningCrescent" Width="26" Height="26" Foreground="#4B5563" />
                                            <TextBlock Text="Dark" Margin="0,6,0,0" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Margin="8,0,0,0" Padding="12" CornerRadius="10" Cursor="Hand"
                                        BorderThickness="2" BorderBrush="#E5E7EB"
                                        Background="#F9FAFB">
                                    <Border.InputBindings>
                                        <MouseBinding Gesture="LeftClick"
                                                      Command="{Binding SetThemeCommand}"
                                                      CommandParameter="{x:Static models:ThemeMode.System}" />
                                    </Border.InputBindings>
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="BorderBrush" Value="#E5E7EB" />
                                            <Setter Property="Background" Value="#F9FAFB" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.System}">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                    <Setter Property="Background" Value="#EEF4FF" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <materialDesign:PackIcon Kind="CheckCircle"
                                                                 Width="16"
                                                                 Height="16"
                                                                 HorizontalAlignment="Right"
                                                                 VerticalAlignment="Top"
                                                                 Foreground="{DynamicResource AccentBrush}">
                                            <materialDesign:PackIcon.Style>
                                                <Style TargetType="materialDesign:PackIcon">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.System}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </materialDesign:PackIcon.Style>
                                        </materialDesign:PackIcon>
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="Monitor" Width="26" Height="26" Foreground="#6B7280" />
                                            <TextBlock Text="System" Margin="0,6,0,0" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </UniformGrid>

                            <TextBlock Text="Accent Preset" FontWeight="SemiBold" Foreground="#374151" Margin="0,0,0,8" />
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" MaxHeight="220">
                                <ItemsControl ItemsSource="{Binding Presets}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:ColorScheme}">
                                            <Border Margin="0,0,8,8" Padding="10,8" CornerRadius="8" Cursor="Hand"
                                                    BorderThickness="2" BorderBrush="#E5E7EB"
                                                    Tag="{Binding Name}">
                                                <Border.InputBindings>
                                                    <MouseBinding Gesture="LeftClick"
                                                                  Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                  CommandParameter="{Binding Name}" />
                                                </Border.InputBindings>
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="BorderBrush" Value="#E5E7EB" />
                                                        <Setter Property="Background" Value="#F9FAFB" />
                                                        <Style.Triggers>
                                                            <DataTrigger Value="True">
                                                                <DataTrigger.Binding>
                                                                    <MultiBinding Converter="{StaticResource StringEqualityConverter}">
                                                                        <Binding Path="Name" />
                                                                        <Binding Path="DataContext.SelectedPresetName" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                    </MultiBinding>
                                                                </DataTrigger.Binding>
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                <Setter Property="Background" Value="#EEF4FF" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                        <Ellipse Width="16" Height="16" Margin="0,0,8,0">
                                                            <Ellipse.Fill>
                                                                <SolidColorBrush Color="{Binding AccentColor, Converter={StaticResource HexToColorConverter}}" />
                                                            </Ellipse.Fill>
                                                        </Ellipse>
                                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                                                    </StackPanel>

                                                    <materialDesign:PackIcon Grid.Column="1"
                                                                             Kind="CheckCircle"
                                                                             Width="14"
                                                                             Height="14"
                                                                             Margin="8,0,0,0"
                                                                             VerticalAlignment="Center"
                                                                             Foreground="{DynamicResource AccentBrush}">
                                                        <materialDesign:PackIcon.Style>
                                                            <Style TargetType="materialDesign:PackIcon">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Value="True">
                                                                        <DataTrigger.Binding>
                                                                            <MultiBinding Converter="{StaticResource StringEqualityConverter}">
                                                                                <Binding Path="Name" />
                                                                                <Binding Path="DataContext.SelectedPresetName" RelativeSource="{RelativeSource AncestorType=Window}" />
                                                                            </MultiBinding>
                                                                        </DataTrigger.Binding>
                                                                        <Setter Property="Visibility" Value="Visible" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </materialDesign:PackIcon.Style>
                                                    </materialDesign:PackIcon>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem>
                    <Grid>
                        <StackPanel>
                            <TextBlock Text="You are all set!"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="#111827" />
                            <TextBlock Text="Review your branding preview, then launch Craft Track."
                                       Margin="0,8,0,20"
                                       Foreground="#6B7280" />

                            <Border CornerRadius="12" BorderThickness="1" BorderBrush="#E5E7EB" Padding="14" Background="#F9FAFB">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}" CornerRadius="8" Padding="12">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <Border Width="36" Height="36" CornerRadius="8" Background="#26FFFFFF" Margin="0,0,10,0">
                                                    <Image Source="{Binding LogoPreview}" Stretch="UniformToFill" />
                                                </Border>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding AppName}" Foreground="White" FontWeight="Bold" FontSize="13" />
                                                    <TextBlock Text="{Binding AppSubtitle}" Foreground="#E5E7EB" FontSize="9" />
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="Window title preview" Foreground="#6B7280" FontSize="12" />
                                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" FontSize="16" Foreground="#111827" />
                                        <TextBlock Text="Theme" Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding SelectedTheme}" FontWeight="SemiBold" Foreground="#111827" />
                                        <TextBlock Text="Preset" Foreground="#6B7280" FontSize="12" Margin="0,10,0,0" />
                                        <TextBlock Text="{Binding SelectedPresetName}" FontWeight="SemiBold" Foreground="#111827" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Grid>
                </TabItem>
            </TabControl>

            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0"
                        Content="Back"
                        Style="{StaticResource ModernOutlinedButton}"
                        Command="{Binding BackCommand}"
                        Visibility="{Binding CanGoBack, Converter={StaticResource BoolToVisibility}}"
                        Padding="16,9" />

                <Button Grid.Column="2"
                        Content="{Binding NextButtonText}"
                        Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding NextCommand}"
                        Visibility="{Binding IsFinalStep, Converter={StaticResource InverseBoolToVisibility}}"
                        Padding="18,9"
                        Margin="10,0,0,0" />

                <Button Grid.Column="3"
                        Content="Launch App"
                        Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding FinishCommand}"
                        Visibility="{Binding IsFinalStep, Converter={StaticResource BoolToVisibility}}"
                        Padding="18,9"
                        Margin="10,0,0,0" />
            </Grid>
        </Grid>
    </Border>
</Window>
