<UserControl x:Class="CraftTrack.Views.NotificationCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ══════ Header ══════ -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Background="{DynamicResource NotifHeaderBgBrush}" CornerRadius="10" Width="40" Height="40">
                <materialDesign:PackIcon Kind="BellOutline" Width="20" Height="20" Foreground="{DynamicResource NotifHeaderFgBrush}"
                                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="Notification Center" FontSize="20" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Margin="12,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <!-- ══════ Toolbar ══════ -->
        <Border Grid.Row="1" Style="{StaticResource ModernCard}" Padding="14,10" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource ModernOutlinedButton}" Command="{Binding AcknowledgeAllCommand}"
                        Margin="0,0,8,4" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="CheckAll" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Acknowledge All" FontSize="12.5" />
                    </StackPanel>
                </Button>

                <Button Style="{StaticResource ModernOutlinedButton}" Command="{Binding DismissAllAcknowledgedCommand}"
                        Margin="0,0,8,4" Padding="12,7">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="DeleteSweepOutline" Width="16" Height="16"
                                                 Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Dismiss Acknowledged" FontSize="12.5" Foreground="{DynamicResource TextMutedBrush}" />
                    </StackPanel>
                </Button>

                <CheckBox Content="Show Acknowledged" IsChecked="{Binding ShowAcknowledged}"
                          Margin="14,0,0,4" VerticalAlignment="Center" FontSize="13" />
            </WrapPanel>
        </Border>

        <!-- ══════ Notification DataGrid ══════ -->
        <Border Grid.Row="2" Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Notifications}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}">
                <DataGrid.Columns>
                    <!-- Type Icon -->
                    <DataGridTemplateColumn Header="" Width="44" CanUserResize="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center"
                                                         HorizontalAlignment="Center">
                                    <materialDesign:PackIcon.Style>
                                        <Style TargetType="materialDesign:PackIcon">
                                            <Setter Property="Kind" Value="BellOutline"/>
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Type}" Value="OrderOverdue">
                                                    <Setter Property="Kind" Value="AlertCircleOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotifOverdueBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="OrderDueIn1Day">
                                                    <Setter Property="Kind" Value="ClockAlertOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotifDue1DayBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="OrderDueIn3Days">
                                                    <Setter Property="Kind" Value="ClockOutline"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotifDue3DayBrush}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="RushOrderCreated">
                                                    <Setter Property="Kind" Value="FlashAlert"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource RushColor}"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Type}" Value="LowStock">
                                                    <Setter Property="Kind" Value="PackageVariantClosedRemove"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource NotifDue3DayBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </materialDesign:PackIcon.Style>
                                </materialDesign:PackIcon>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Message -->
                    <DataGridTextColumn Header="Message" Binding="{Binding Message}" Width="*">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAcknowledged}" Value="False">
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <!-- Created -->
                    <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, StringFormat='{}{0:g}'}" Width="150"/>

                    <!-- Status -->
                    <DataGridTemplateColumn Header="Status" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="10" Padding="10,4" HorizontalAlignment="Left">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="{DynamicResource PillNewBgBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                    <Setter Property="Background" Value="{DynamicResource PillAckBgBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="New"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PillNewFgBrush}"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsAcknowledged}" Value="True">
                                                        <Setter Property="Text" Value="Acknowledged"/>
                                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Actions -->
                    <DataGridTemplateColumn Header="" Width="120">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernIconButton}" ToolTip="Acknowledge"
                                            Command="{Binding DataContext.AcknowledgeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Visibility="{Binding IsAcknowledged, Converter={StaticResource InverseBoolToVisibility}}">
                                        <materialDesign:PackIcon Kind="Check" Width="17" Height="17"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernIconButton}" ToolTip="View Related"
                                            Command="{Binding DataContext.ViewRelatedCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="OpenInNew" Width="17" Height="17"/>
                                    </Button>
                                    <Button Style="{StaticResource ModernIconButtonDanger}" ToolTip="Dismiss"
                                            Command="{Binding DataContext.DismissCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="Close" Width="17" Height="17"/>
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- ══════ Empty State ══════ -->
        <StackPanel Grid.Row="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Visibility="{Binding HasNoNotifications, Converter={StaticResource BoolToVisibility}}">
            <materialDesign:PackIcon Kind="BellOffOutline" Width="48" Height="48"
                                     Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="No notifications to show." FontSize="15"
                       Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>
