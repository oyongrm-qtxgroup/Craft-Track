<UserControl x:Class="CraftTrack.Views.OrderListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:enums="clr-namespace:CraftTrack.Models.Enums">

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <DockPanel>
        <!-- ══════ Toolbar ══════ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource ModernCard}" Padding="16,12" Margin="0,0,0,16">
            <WrapPanel VerticalAlignment="Center">
                <Button Style="{StaticResource ModernPrimaryButton}" Command="{Binding AddOrderCommand}" Margin="0,0,14,4">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Plus" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="New Order" />
                    </StackPanel>
                </Button>

                <Border Background="{DynamicResource SearchBgBrush}" CornerRadius="8" Padding="10,0" Margin="0,0,10,4" Height="36">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Magnify" Width="18" Height="18" Foreground="{DynamicResource TextMutedBrush}"
                                                 VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" VerticalAlignment="Center"
                                 Width="160" FontSize="13"
                                 materialDesign:HintAssist.Hint="Search orders..." />
                    </StackPanel>
                </Border>

                <ComboBox materialDesign:HintAssist.Hint="Severity" Width="110" Margin="0,0,8,4"
                          SelectedValue="{Binding FilterSeverity}" SelectedValuePath="Tag"
                          VerticalAlignment="Center" FontSize="13">
                    <ComboBoxItem Content="All" Tag="{x:Null}" />
                    <ComboBoxItem Content="Rush" Tag="{x:Static enums:SeverityLevel.Rush}" />
                    <ComboBoxItem Content="High" Tag="{x:Static enums:SeverityLevel.High}" />
                    <ComboBoxItem Content="Low" Tag="{x:Static enums:SeverityLevel.Low}" />
                </ComboBox>

                <ComboBox materialDesign:HintAssist.Hint="Status" Width="110" Margin="0,0,8,4"
                          SelectedValue="{Binding FilterStatus}" SelectedValuePath="Tag"
                          VerticalAlignment="Center" FontSize="13">
                    <ComboBoxItem Content="All" Tag="{x:Null}" />
                    <ComboBoxItem Content="Active" Tag="{x:Static enums:OrderStatus.Active}" />
                    <ComboBoxItem Content="In Progress" Tag="{x:Static enums:OrderStatus.InProgress}" />
                    <ComboBoxItem Content="Completed" Tag="{x:Static enums:OrderStatus.Completed}" />
                    <ComboBoxItem Content="Cancelled" Tag="{x:Static enums:OrderStatus.Cancelled}" />
                </ComboBox>

                <ComboBox materialDesign:HintAssist.Hint="Payment" Width="120" Margin="0,0,10,4"
                          SelectedValue="{Binding FilterPaymentType}" SelectedValuePath="Tag"
                          VerticalAlignment="Center" FontSize="13">
                    <ComboBoxItem Content="All" Tag="{x:Null}" />
                    <ComboBoxItem Content="Full Payment" Tag="{x:Static enums:PaymentType.FullPayment}" />
                    <ComboBoxItem Content="Downpayment" Tag="{x:Static enums:PaymentType.Downpayment}" />
                    <ComboBoxItem Content="Unpaid" Tag="{x:Static enums:PaymentType.Unpaid}" />
                </ComboBox>

                <TextBlock Text="Ordered:" VerticalAlignment="Center" FontSize="11" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,4" />
                <DatePicker SelectedDate="{Binding FilterDateFrom}" Width="110" Margin="0,0,4,4"
                            materialDesign:HintAssist.Hint="From" FontSize="12" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding FilterDateTo}" Width="110" Margin="0,0,10,4"
                            materialDesign:HintAssist.Hint="To" FontSize="12" VerticalAlignment="Center" />

                <TextBlock Text="Deadline:" VerticalAlignment="Center" FontSize="11" FontWeight="Medium"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,4,4" />
                <DatePicker SelectedDate="{Binding FilterDeadlineFrom}" Width="110" Margin="0,0,4,4"
                            materialDesign:HintAssist.Hint="From" FontSize="12" VerticalAlignment="Center" />
                <DatePicker SelectedDate="{Binding FilterDeadlineTo}" Width="110" Margin="0,0,10,4"
                            materialDesign:HintAssist.Hint="To" FontSize="12" VerticalAlignment="Center" />

                <Button Style="{StaticResource ModernOutlinedButton}" Command="{Binding ApplyFiltersCommand}"
                        Padding="14,8" Margin="0,0,6,4">
                    <TextBlock Text="Apply" FontSize="12.5" />
                </Button>
                <Button Style="{StaticResource ModernIconButton}" Command="{Binding ClearFiltersCommand}"
                        ToolTip="Clear filters" Margin="0,0,0,4">
                    <materialDesign:PackIcon Kind="FilterRemoveOutline" Width="18" Height="18" />
                </Button>
            </WrapPanel>
        </Border>

        <!-- ══════ DataGrid ══════ -->
        <Border Style="{StaticResource ModernCard}" Padding="0">
            <DataGrid ItemsSource="{Binding Orders}"
                      SelectedItem="{Binding SelectedOrder}"
                      Style="{StaticResource ModernDataGrid}"
                      ColumnHeaderStyle="{StaticResource ModernColumnHeader}"
                      CellStyle="{StaticResource ModernDataGridCell}"
                      RowStyle="{StaticResource ModernDataGridRow}"
                      CanUserSortColumns="True"
                      MouseDoubleClick="DataGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Order #" Binding="{Binding Id}" Width="70" />
                    <DataGridTextColumn Header="Customer" Binding="{Binding Customer.FullName}" Width="*" />
                    <DataGridTextColumn Header="Ordered" Binding="{Binding DateOrdered, StringFormat=d}" Width="100" />
                    <DataGridTextColumn Header="Due" Binding="{Binding DueDate, StringFormat=d}" Width="100" />
                    <DataGridTemplateColumn Header="Severity" Width="90" SortMemberPath="Severity">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityColorConverter}}"
                                        Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding Severity}" Style="{StaticResource PillText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Total" Binding="{Binding TotalPrice, Converter={StaticResource CurrencyConverter}}" Width="100" />
                    <DataGridTemplateColumn Header="Payment" Width="110" SortMemberPath="PaymentType">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding PaymentType, Converter={StaticResource PaymentColorConverter}}"
                                        Style="{StaticResource Pill}">
                                    <TextBlock Text="{Binding PaymentType, Converter={StaticResource EnumDescriptionConverter}}"
                                               Style="{StaticResource PillText}" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Paid" Binding="{Binding AmountPaid, Converter={StaticResource CurrencyConverter}}" Width="100" />
                    <DataGridTextColumn Header="Balance" Binding="{Binding BalanceDue, Converter={StaticResource CurrencyConverter}}" Width="100" />
                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Converter={StaticResource EnumDescriptionConverter}}" Width="100" />
                    <DataGridTemplateColumn Header="" Width="Auto" MinWidth="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ModernIconButton}" ToolTip="Edit"
                                            Command="{Binding DataContext.EditOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="PencilOutline" Width="17" Height="17" />
                                    </Button>
                                    <Button Style="{StaticResource ModernIconButtonDanger}" ToolTip="Delete"
                                            Command="{Binding DataContext.DeleteOrderCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}">
                                        <materialDesign:PackIcon Kind="TrashCanOutline" Width="17" Height="17" />
                                    </Button>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
