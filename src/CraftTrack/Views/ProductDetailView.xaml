<UserControl x:Class="CraftTrack.Views.ProductDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:converters="clr-namespace:CraftTrack.Converters">

    <UserControl.Resources>
        <converters:ImagePathConverter x:Key="ImagePathConverter" />
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel MaxWidth="920" Margin="0,0,0,32">
            <!-- Error Message -->
            <Border Background="{DynamicResource DangerBgBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,16"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircleOutline" Foreground="{DynamicResource DangerTextBrush}" Width="18" Height="18"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource DangerTextBrush}" FontSize="13" VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ══════ Left: Image ══════ -->
                <StackPanel Grid.Column="0" Margin="0,0,24,0">
                    <TextBlock Text="Product Image" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource ModernCard}" Height="240" ClipToBounds="True" Cursor="Hand"
                            Margin="0,0,0,8">
                        <Border.InputBindings>
                            <MouseBinding MouseAction="LeftClick" Command="{Binding BrowseImageCommand}" />
                        </Border.InputBindings>
                        <Grid>
                            <!-- Placeholder -->
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="{Binding ImagePreview, Converter={StaticResource InverseBoolToVisibility}}">
                                <materialDesign:PackIcon Kind="CameraPlus" Width="48" Height="48"
                                                         HorizontalAlignment="Center"
                                                         Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="Click to add image" FontSize="12"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Margin="0,8,0,0" />
                            </StackPanel>
                            <!-- Preview -->
                            <Image Source="{Binding ImagePreview}" Stretch="UniformToFill"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource ModernOutlinedButton}" Padding="12,6"
                                Command="{Binding BrowseImageCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Upload" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Browse" FontSize="12" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ModernOutlinedButton}" Padding="12,6" Margin="8,0,0,0"
                                Command="{Binding RemoveImageCommand}"
                                Visibility="{Binding ImagePreview, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="14" Height="14" VerticalAlignment="Center" Margin="0,0,4,0" />
                                <TextBlock Text="Remove" FontSize="12" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>

                <!-- ══════ Right: Product Info ══════ -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="Product Information" Style="{StaticResource SectionTitle}" />
                    <Border Style="{StaticResource ModernCard}" Padding="24" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBox Text="{Binding ProductName, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Product Name *"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     Margin="0,0,0,16" />

                            <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}"
                                     materialDesign:HintAssist.Hint="Description"
                                     Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                     AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60"
                                     Margin="0,0,0,16" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <TextBox Grid.Column="0"
                                         Text="{Binding DefaultPrice, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         materialDesign:HintAssist.Hint="Selling Price (₱) *"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="0,0,8,0" />

                                <TextBox Grid.Column="1"
                                         Text="{Binding LaborCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         materialDesign:HintAssist.Hint="Labor Cost (₱)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="8,0,8,0" />

                                <TextBox Grid.Column="2"
                                         Text="{Binding OverheadCost, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                         materialDesign:HintAssist.Hint="Overhead Cost (₱)"
                                         Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                         Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

            <!-- ══════ Bill of Materials ══════ -->
            <DockPanel Margin="0,4,0,10">
                <TextBlock Text="Bill of Materials" Style="{StaticResource SectionTitle}" DockPanel.Dock="Left"
                           VerticalAlignment="Center" Margin="0" />
            </DockPanel>
            <Border Style="{StaticResource ModernCard}" Padding="20" Margin="0,0,0,20">
                <StackPanel>
                    <!-- Add material search -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0" x:Name="MaterialSearchBox"
                                 Text="{Binding InventorySearchTerm, UpdateSourceTrigger=PropertyChanged, Delay=200}"
                                 materialDesign:HintAssist.Hint="Search inventory to add material..."
                                 materialDesign:TextFieldAssist.HasLeadingIcon="True"
                                 materialDesign:TextFieldAssist.LeadingIcon="Magnify"
                                 Style="{StaticResource MaterialDesignOutlinedTextBox}"
                                 TextChanged="MaterialSearch_TextChanged" />

                        <Popup IsOpen="{Binding IsInventoryDropdownOpen}" StaysOpen="False"
                               PlacementTarget="{Binding ElementName=MaterialSearchBox}"
                               Placement="Bottom" Width="500">
                            <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" MaxHeight="250">
                                <ListBox ItemsSource="{Binding InventorySuggestions}"
                                         SelectionChanged="InventorySuggestion_Selected">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Margin="4">
                                                <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16"
                                                                         VerticalAlignment="Center" Margin="0,0,8,0"
                                                                         Foreground="{DynamicResource PrimaryBrush}" />
                                                <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                    <TextBlock>
                                                        <Run Text="{Binding Name}" FontWeight="SemiBold" />
                                                        <Run Text=" — " />
                                                        <Run Text="{Binding UnitOfMeasure}" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text=" (Stock: " Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text="{Binding Quantity, StringFormat=N2}" Foreground="{DynamicResource TextMutedBrush}" />
                                                        <Run Text=")" Foreground="{DynamicResource TextMutedBrush}" />
                                                    </TextBlock>
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                        <Run Text="{Binding Variant}" />
                                                        <Run Text=" " />
                                                        <Run Text="{Binding Size}" />
                                                    </TextBlock>
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Border>
                        </Popup>
                    </Grid>

                    <!-- Materials list header -->
                    <Grid Margin="0,0,0,4"
                          Visibility="{Binding Materials.Count, Converter={StaticResource BoolToVisibility}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="36" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Material" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="1" Text="Unit" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="2" Text="Qty Required" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Grid.Column="3" Text="Cost" FontSize="11" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>

                    <!-- Materials rows -->
                    <ItemsControl ItemsSource="{Binding Materials}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderLightBrush}" BorderThickness="0,0,0,1" Padding="0,8" Margin="0,0,0,2">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="100" />
                                            <ColumnDefinition Width="36" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                            <materialDesign:PackIcon Kind="CubeOutline" Width="16" Height="16"
                                                                     Foreground="{DynamicResource PrimaryBrush}"
                                                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                                            <StackPanel Orientation="Vertical" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding InventoryItemName}" FontWeight="Medium"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                    <TextBlock Text="{Binding Variant}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding Variant, Converter={StaticResource BoolToVisibility}}"/>
                                                    <TextBlock Text="{Binding Size, StringFormat=' - {0}'}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Visibility="{Binding Size, Converter={StaticResource BoolToVisibility}}"/>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>

                                        <TextBlock Grid.Column="1" Text="{Binding UnitOfMeasure}"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center" />

                                        <TextBox Grid.Column="2"
                                                 Text="{Binding QuantityRequired, UpdateSourceTrigger=PropertyChanged, StringFormat=N2}"
                                                 VerticalAlignment="Center" Margin="0,0,8,0" />

                                        <TextBlock Grid.Column="3"
                                                   Text="{Binding MaterialCost, Converter={StaticResource CurrencyConverter}}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   VerticalAlignment="Center" FontWeight="Medium" />

                                        <Button Grid.Column="4" Style="{StaticResource ModernIconButtonDanger}"
                                                Command="{Binding DataContext.RemoveMaterialCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" Width="28" Height="28">
                                            <materialDesign:PackIcon Kind="Close" Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Empty state -->
                    <TextBlock Text="No materials added yet. Search inventory above to add materials."
                               FontSize="13" Foreground="{DynamicResource TextMutedBrush}"
                               HorizontalAlignment="Center" Margin="0,16,0,16"
                               Visibility="{Binding Materials.Count, Converter={StaticResource InverseBoolToVisibility}}" />
                </StackPanel>
            </Border>

            <!-- ══════ Action Buttons ══════ -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,24">
                <Button Style="{StaticResource ModernOutlinedButton}"
                        Command="{Binding CancelCommand}" Margin="0,0,12,0" Padding="20,10">
                    <TextBlock Text="Cancel" />
                </Button>
                <Button Style="{StaticResource ModernPrimaryButton}"
                        Command="{Binding SaveProductCommand}" Padding="20,10">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="ContentSaveOutline" Width="17" Height="17" VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBlock Text="Save Product" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
