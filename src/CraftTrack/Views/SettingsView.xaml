<UserControl x:Class="CraftTrack.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:models="clr-namespace:CraftTrack.Models">

    <UserControl.Resources>
        <!-- Converts a Color to a SolidColorBrush for swatch display -->
        <Style x:Key="SwatchRect" TargetType="Rectangle">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="RadiusX" Value="8" />
            <Setter Property="RadiusY" Value="8" />
        </Style>
    </UserControl.Resources>

    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <BeginStoryboard Storyboard="{StaticResource FadeSlideIn}" />
        </EventTrigger>
    </UserControl.Triggers>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0">
        <StackPanel MaxWidth="640" Margin="0,0,0,32">

            <!-- ══════ Business Branding Section ══════ -->
            <TextBlock Text="Business Branding" Style="{StaticResource SectionTitle}" FontSize="17" />
            <TextBlock Text="Set your store name, description, and sidebar logo (PNG)."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       Margin="0,0,0,16" />

            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,24">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,16,0">
                            <TextBlock Text="Store Name" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding BrandingAppName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" />

                            <TextBlock Text="Description" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <TextBox Text="{Binding BrandingAppSubtitle, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Logo Preview" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border Width="64" Height="64" CornerRadius="32"
                                    Background="{DynamicResource HoverBgBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    HorizontalAlignment="Left">
                                <Image Source="{Binding BrandingLogoPreview}" Stretch="UniformToFill" />
                            </Border>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Sidebar Logo (PNG)" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                            <TextBlock Text="{Binding PendingLogoPngPath}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Browse..." Style="{StaticResource ModernOutlinedButton}"
                                Command="{Binding BrowseLogoCommand}" Padding="12,6" VerticalAlignment="Center" />
                    </Grid>

                    <DockPanel>
                        <TextBlock Text="Branding changes apply to the app sidebar and title text."
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   FontSize="12"
                                   VerticalAlignment="Center" />
                        <Button DockPanel.Dock="Right"
                                Content="Apply Changes"
                                Style="{StaticResource ModernPrimaryButton}"
                                Command="{Binding ApplyBrandingCommand}"
                                Padding="16,8" />
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- ══════ Appearance Section ══════ -->
            <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" FontSize="17" />
            <TextBlock Text="Choose how Craft Track looks. Select a theme to match your preference."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       Margin="0,0,0,20" />

            <!-- Theme Cards -->
            <UniformGrid Columns="3" Margin="0,0,0,32">

                <!-- Light -->
                <Border x:Name="LightCard" CornerRadius="14" Padding="20,24"
                        Margin="0,0,10,0" Cursor="Hand"
                        MouseLeftButtonUp="LightCard_Click"
                        BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.Light}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.18" Color="#7C3AED" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#FFF8E1" CornerRadius="12" Width="52" Height="52"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="WhiteBalanceSunny" Width="26" Height="26"
                                                     Foreground="#F59E0B"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Light" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Bright &amp; clean" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- Dark -->
                <Border x:Name="DarkCard" CornerRadius="14" Padding="20,24"
                        Margin="5,0,5,0" Cursor="Hand"
                        MouseLeftButtonUp="DarkCard_Click"
                        BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.Dark}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.18" Color="#7C3AED" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#1E1B4B" CornerRadius="12" Width="52" Height="52"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="MoonWaningCrescent" Width="26" Height="26"
                                                     Foreground="#C4B5FD"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="Dark" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Easy on the eyes" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>

                <!-- System -->
                <Border x:Name="SystemCard" CornerRadius="14" Padding="20,24"
                        Margin="10,0,0,0" Cursor="Hand"
                        MouseLeftButtonUp="SystemCard_Click"
                        BorderThickness="2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                            <Setter Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTheme}" Value="{x:Static models:ThemeMode.System}">
                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                    <Setter Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.18" Color="#7C3AED" />
                                        </Setter.Value>
                                    </Setter>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel HorizontalAlignment="Center">
                        <Border Background="#EDE9FE" CornerRadius="12" Width="52" Height="52"
                                HorizontalAlignment="Center" Margin="0,0,0,14">
                            <materialDesign:PackIcon Kind="MonitorShimmer" Width="26" Height="26"
                                                     Foreground="#7C3AED"
                                                     HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Text="System" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Follow Windows" FontSize="11.5"
                                   Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,3,0,0" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ══════ Color Scheme Section ══════ -->
            <TextBlock Text="Color Scheme" Style="{StaticResource SectionTitle}" FontSize="17" />
            <TextBlock Text="Pick a preset or customize individual colors. Changes apply instantly."
                       Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                       Margin="0,0,0,16" />

            <!-- Preset Selector -->
            <ItemsControl ItemsSource="{Binding Presets}" Margin="0,0,0,16">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type models:ColorScheme}">
                        <Border x:Name="PresetCard" CornerRadius="10" Padding="12,10" Margin="0,0,8,8"
                                Cursor="Hand" BorderThickness="2"
                                MouseLeftButtonUp="PresetCard_Click"
                                Tag="{Binding Name}">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Value="True">
                                            <DataTrigger.Binding>
                                                <MultiBinding Converter="{StaticResource StringEqualityConverter}">
                                                    <Binding Path="Name" />
                                                    <Binding Path="DataContext.SelectedPresetName"
                                                             RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                </MultiBinding>
                                            </DataTrigger.Binding>
                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="18" Height="18" Margin="0,0,8,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding AccentColor, Converter={StaticResource HexToColorConverter}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <Ellipse Width="18" Height="18" Margin="0,0,10,0">
                                    <Ellipse.Fill>
                                        <SolidColorBrush Color="{Binding SecondaryColor, Converter={StaticResource HexToColorConverter}}" />
                                    </Ellipse.Fill>
                                </Ellipse>
                                <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="Medium"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Custom Color Pickers -->
            <Border CornerRadius="14" Padding="24"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                    Margin="0,0,0,12">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <DockPanel Margin="0,0,0,16">
                        <TextBlock Text="Custom Colors" FontSize="14" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <!-- Custom indicator + Reset -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                    Visibility="{Binding IsCustom, Converter={StaticResource BoolToVisibility}}">
                            <Border CornerRadius="8" Background="{DynamicResource WarningBgBrush}" Padding="8,3" Margin="0,0,8,0">
                                <TextBlock Text="Modified" FontSize="10" FontWeight="SemiBold"
                                           Foreground="{DynamicResource WarningTextBrush}" />
                            </Border>
                            <Button Content="Reset" FontSize="11" Padding="10,3"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{DynamicResource AccentBrush}"
                                    Command="{Binding ResetToPresetCommand}" />
                        </StackPanel>
                    </DockPanel>

                    <!-- Color grid: 2 rows × 3 columns -->
                    <UniformGrid Columns="3" Rows="2">
                        <!-- Accent -->
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="Accent" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" MouseLeftButtonUp="AccentColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="24" Height="24" RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding AccentColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding AccentColor, Converter={StaticResource ColorToHexDisplay}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Secondary -->
                        <StackPanel Margin="0,0,12,16">
                            <TextBlock Text="Secondary" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" MouseLeftButtonUp="SecondaryColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="24" Height="24" RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding SecondaryColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding SecondaryColor, Converter={StaticResource ColorToHexDisplay}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Success -->
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Success" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" MouseLeftButtonUp="SuccessColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="24" Height="24" RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding SuccessColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding SuccessColor, Converter={StaticResource ColorToHexDisplay}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Warning -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Warning" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" MouseLeftButtonUp="WarningColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="24" Height="24" RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding WarningColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding WarningColor, Converter={StaticResource ColorToHexDisplay}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Danger -->
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="Danger" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" MouseLeftButtonUp="DangerColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="24" Height="24" RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding DangerColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding DangerColor, Converter={StaticResource ColorToHexDisplay}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Sidebar -->
                        <StackPanel Margin="0,0,0,0">
                            <TextBlock Text="Sidebar" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                            <Border CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="8,6" Cursor="Hand" MouseLeftButtonUp="SidebarColor_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Rectangle Width="24" Height="24" RadiusX="6" RadiusY="6">
                                        <Rectangle.Fill>
                                            <SolidColorBrush Color="{Binding SidebarColor}" />
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                               VerticalAlignment="Center" Margin="8,0,0,0"
                                               Text="{Binding SidebarColor, Converter={StaticResource ColorToHexDisplay}}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- Color Picker Popup Overlay -->
            <Popup x:Name="ColorPickerPopup" StaysOpen="False" Placement="Mouse"
                   AllowsTransparency="True" PopupAnimation="Fade">
                <Border CornerRadius="12" Padding="16" Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.15" Color="Black" />
                    </Border.Effect>
                    <StackPanel>
                        <materialDesign:ColorPicker x:Name="ColorPicker" Width="260" Height="320" />
                        <DockPanel Margin="0,12,0,0">
                            <Button Content="Cancel" DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignFlatButton}"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    Click="ColorPickerCancel_Click" Margin="8,0,0,0" />
                            <Button Content="Apply" DockPanel.Dock="Right"
                                    Style="{StaticResource MaterialDesignFlatMidBgButton}"
                                    Background="{DynamicResource AccentBrush}" Foreground="White"
                                    Click="ColorPickerApply_Click" />
                            <TextBlock />
                        </DockPanel>
                    </StackPanel>
                </Border>
            </Popup>

            <!-- ══════ About Section ══════ -->
            <TextBlock Text="About" Style="{StaticResource SectionTitle}" FontSize="17" />
            <Border CornerRadius="14" Padding="24"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.06" Color="Black" />
                </Border.Effect>
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <materialDesign:PackIcon Kind="Cube" Width="22" Height="22"
                                                 Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"
                                                 Margin="0,0,10,0" />
                        <TextBlock Text="CraftTrack" FontSize="16" FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="v1.0" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" Margin="8,2,0,0" />
                    </StackPanel>
                    <TextBlock Text="Order &amp; Operations Manager for small handcraft businesses."
                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="13"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
