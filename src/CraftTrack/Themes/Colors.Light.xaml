<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         CraftTrack — Light Theme Colors (Purple & Pink)
         ═══════════════════════════════════════════════════ -->

    <!-- Core Brushes -->
    <SolidColorBrush x:Key="AccentBrush"          Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentLightBrush"      Color="#A78BFA" />
    <SolidColorBrush x:Key="AccentDarkBrush"       Color="#6D28D9" />
    <SolidColorBrush x:Key="AccentSecondaryBrush"  Color="#EC4899" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#F8FAFB" />
    <SolidColorBrush x:Key="CardBrush"             Color="#FFFFFF" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"           Color="#E2E8F0" />
    <SolidColorBrush x:Key="BorderLightBrush"      Color="#F1F5F9" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#1E1B4B" />
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#64748B" />
    <SolidColorBrush x:Key="TextMutedBrush"        Color="#94A3B8" />

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBrush"           Color="#EF4444" />
    <SolidColorBrush x:Key="WarningBrush"          Color="#F59E0B" />
    <SolidColorBrush x:Key="SuccessBrush"          Color="#10B981" />

    <!-- Sidebar -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#5B21B6" Offset="0" />
        <GradientStop Color="#9D174D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarSectionBrush"   Color="#FBCFE8" />
    <SolidColorBrush x:Key="SidebarIconBrush"      Color="#F9A8D4" />
    <SolidColorBrush x:Key="SidebarSubtitleBrush"  Color="#F472B6" />
    <SolidColorBrush x:Key="SidebarLogoBgBrush"    Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SidebarDividerBrush"   Color="#1AFFFFFF" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="ColumnHeaderBgBrush"   Color="#FAFBFC" />
    <SolidColorBrush x:Key="RowBorderBrush"        Color="#F1F5F9" />
    <SolidColorBrush x:Key="RowHoverBrush"         Color="#FDF2F8" />
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#FCE7F3" />

    <!-- Interactive States -->
    <SolidColorBrush x:Key="SearchBgBrush"         Color="#F1F5F9" />
    <SolidColorBrush x:Key="HoverBgBrush"          Color="#F1F5F9" />
    <SolidColorBrush x:Key="PressedBgBrush"        Color="#E2E8F0" />
    <SolidColorBrush x:Key="OutlinedHoverBgBrush"  Color="#0DEC4899" />

    <!-- Status Backgrounds -->
    <SolidColorBrush x:Key="DangerBgBrush"         Color="#FEF2F2" />
    <SolidColorBrush x:Key="DangerTextBrush"       Color="#DC2626" />
    <SolidColorBrush x:Key="SuccessBgBrush"        Color="#DCFCE7" />
    <SolidColorBrush x:Key="SuccessTextBrush"      Color="#16A34A" />
    <SolidColorBrush x:Key="WarningBgBrush"        Color="#FEF3C7" />
    <SolidColorBrush x:Key="WarningTextBrush"      Color="#D97706" />

    <!-- Overlays -->
    <SolidColorBrush x:Key="LoadingOverlayBrush"   Color="#CCF8FAFB" />

    <!-- Dashboard Stat Icon Circles -->
    <SolidColorBrush x:Key="StatIconBg1"           Color="#FDF2F8" />
    <SolidColorBrush x:Key="StatIconFg1"           Color="#EC4899" />
    <SolidColorBrush x:Key="StatIconBg2"           Color="#FDF2F8" />
    <SolidColorBrush x:Key="StatIconFg2"           Color="#EC4899" />
    <SolidColorBrush x:Key="StatIconBg3"           Color="#FEF2F2" />
    <SolidColorBrush x:Key="StatIconFg3"           Color="#EF4444" />
    <SolidColorBrush x:Key="StatIconBg4"           Color="#F5F3FF" />
    <SolidColorBrush x:Key="StatIconFg4"           Color="#8B5CF6" />

    <!-- Financial Gradients -->
    <LinearGradientBrush x:Key="RevenueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#10B981" Offset="0" />
        <GradientStop Color="#059669" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RevenueSubtitleBrush"  Color="#D1FAE5" />
    <SolidColorBrush x:Key="RevenueWatermarkBrush" Color="#34D399" />
    <LinearGradientBrush x:Key="ExpenseGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EF4444" Offset="0" />
        <GradientStop Color="#DC2626" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ExpenseSubtitleBrush"  Color="#FEE2E2" />
    <SolidColorBrush x:Key="ExpenseWatermarkBrush" Color="#FCA5A5" />

    <!-- P&L Card Colors -->
    <SolidColorBrush x:Key="ProfitTextBrush"       Color="#7C3AED" />
    <SolidColorBrush x:Key="ProfitBgBrush"         Color="#F5F3FF" />
    <SolidColorBrush x:Key="OutstandingTextBrush"  Color="#D97706" />
    <SolidColorBrush x:Key="OutstandingBgBrush"    Color="#FEF3C7" />

    <!-- P&L Gradient Cards -->
    <LinearGradientBrush x:Key="ProfitGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7C3AED" Offset="0" />
        <GradientStop Color="#6D28D9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProfitSubtitleBrush"   Color="#DDD6FE" />
    <SolidColorBrush x:Key="ProfitWatermarkBrush"  Color="#A78BFA" />
    <LinearGradientBrush x:Key="OutstandingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D97706" Offset="0" />
        <GradientStop Color="#B45309" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OutstandingSubtitleBrush"  Color="#FDE68A" />
    <SolidColorBrush x:Key="OutstandingWatermarkBrush" Color="#FBBF24" />

    <!-- Expense Category Chart Bars -->
    <SolidColorBrush x:Key="ChartBarMaterials"  Color="#8B5CF6" />
    <SolidColorBrush x:Key="ChartBarTools"      Color="#EC4899" />
    <SolidColorBrush x:Key="ChartBarPackaging"  Color="#F59E0B" />
    <SolidColorBrush x:Key="ChartBarUtilities"  Color="#3B82F6" />
    <SolidColorBrush x:Key="ChartBarOther"      Color="#6B7280" />
    <SolidColorBrush x:Key="ChartBarTrack"      Color="#E5E7EB" />

    <!-- Notification -->
    <SolidColorBrush x:Key="NotifHeaderBgBrush"    Color="#FDF2F8" />
    <SolidColorBrush x:Key="NotifHeaderFgBrush"    Color="#EC4899" />
    <SolidColorBrush x:Key="NotifBadgeBrush"       Color="#EF4444" />
    <SolidColorBrush x:Key="PillNewBgBrush"        Color="#FCE7F3" />
    <SolidColorBrush x:Key="PillNewFgBrush"        Color="#DB2777" />
    <SolidColorBrush x:Key="PillAckBgBrush"        Color="#F1F5F9" />
    <SolidColorBrush x:Key="NotifOverdueBrush"     Color="#DC2626" />
    <SolidColorBrush x:Key="NotifDue1DayBrush"     Color="#EA580C" />
    <SolidColorBrush x:Key="NotifDue3DayBrush"     Color="#D97706" />

    <!-- Severity (status pills) -->
    <SolidColorBrush x:Key="RushColor"             Color="#E53935" />
    <SolidColorBrush x:Key="HighColor"             Color="#FB8C00" />
    <SolidColorBrush x:Key="LowColor"              Color="#43A047" />
    <SolidColorBrush x:Key="PaidColor"             Color="#43A047" />
    <SolidColorBrush x:Key="PartialColor"          Color="#FB8C00" />
    <SolidColorBrush x:Key="UnpaidColor"           Color="#E53935" />

    <!-- Customer Profile -->
    <SolidColorBrush x:Key="RevenueCardBgBrush"    Color="#DCFCE7" />
    <SolidColorBrush x:Key="RevenueCardFgBrush"    Color="#16A34A" />
    <SolidColorBrush x:Key="BalanceCardBgBrush"    Color="#FEE2E2" />
    <SolidColorBrush x:Key="BalanceCardFgBrush"    Color="#DC2626" />

    <!-- Income / Expense header gradients -->
    <LinearGradientBrush x:Key="IncomeHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#16A34A" Offset="0" />
        <GradientStop Color="#22C55E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ExpenseHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#DC2626" Offset="0" />
        <GradientStop Color="#EF4444" Offset="1" />
    </LinearGradientBrush>

    <!-- P&L gradient summary cards -->
    <LinearGradientBrush x:Key="PLRevenueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#16A34A" Offset="0" />
        <GradientStop Color="#22C55E" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PLExpenseGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC2626" Offset="0" />
        <GradientStop Color="#EF4444" Offset="1" />
    </LinearGradientBrush>

    <!-- Gradient card overlay text -->
    <SolidColorBrush x:Key="OverlayWhiteBrush"     Color="#FFFFFF22" />
    <SolidColorBrush x:Key="OverlayTextBrush"      Color="#FFFFFFBB" />

</ResourceDictionary>
