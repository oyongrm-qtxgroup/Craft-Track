<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ═══════════════════════════════════════════════════
         CraftTrack — Dark Theme Colors (Purple & Pink)
         ═══════════════════════════════════════════════════ -->

    <!-- Core Brushes -->
    <SolidColorBrush x:Key="AccentBrush"          Color="#A78BFA" />
    <SolidColorBrush x:Key="AccentLightBrush"      Color="#C4B5FD" />
    <SolidColorBrush x:Key="AccentDarkBrush"       Color="#7C3AED" />
    <SolidColorBrush x:Key="AccentSecondaryBrush"  Color="#F472B6" />

    <!-- Surfaces -->
    <SolidColorBrush x:Key="SurfaceBrush"          Color="#0F172A" />
    <SolidColorBrush x:Key="CardBrush"             Color="#1E293B" />

    <!-- Borders -->
    <SolidColorBrush x:Key="BorderBrush"           Color="#334155" />
    <SolidColorBrush x:Key="BorderLightBrush"      Color="#1E293B" />

    <!-- Text -->
    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="#F1F5F9" />
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="#94A3B8" />
    <SolidColorBrush x:Key="TextMutedBrush"        Color="#64748B" />

    <!-- Status -->
    <SolidColorBrush x:Key="DangerBrush"           Color="#F87171" />
    <SolidColorBrush x:Key="WarningBrush"          Color="#FBBF24" />
    <SolidColorBrush x:Key="SuccessBrush"          Color="#34D399" />

    <!-- Sidebar -->
    <LinearGradientBrush x:Key="SidebarGradient" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#1E1B4B" Offset="0" />
        <GradientStop Color="#500724" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SidebarSectionBrush"   Color="#F9A8D4" />
    <SolidColorBrush x:Key="SidebarIconBrush"      Color="#F472B6" />
    <SolidColorBrush x:Key="SidebarSubtitleBrush"  Color="#F472B6" />
    <SolidColorBrush x:Key="SidebarLogoBgBrush"    Color="#26FFFFFF" />
    <SolidColorBrush x:Key="SidebarDividerBrush"   Color="#1AFFFFFF" />

    <!-- DataGrid -->
    <SolidColorBrush x:Key="ColumnHeaderBgBrush"   Color="#1E293B" />
    <SolidColorBrush x:Key="RowBorderBrush"        Color="#334155" />
    <SolidColorBrush x:Key="RowHoverBrush"         Color="#500724" />
    <SolidColorBrush x:Key="RowSelectedBrush"      Color="#831843" />

    <!-- Interactive States -->
    <SolidColorBrush x:Key="SearchBgBrush"         Color="#1E293B" />
    <SolidColorBrush x:Key="HoverBgBrush"          Color="#334155" />
    <SolidColorBrush x:Key="PressedBgBrush"        Color="#475569" />
    <SolidColorBrush x:Key="OutlinedHoverBgBrush"  Color="#1AF472B6" />

    <!-- Status Backgrounds -->
    <SolidColorBrush x:Key="DangerBgBrush"         Color="#450A0A" />
    <SolidColorBrush x:Key="DangerTextBrush"       Color="#FCA5A5" />
    <SolidColorBrush x:Key="SuccessBgBrush"        Color="#052E16" />
    <SolidColorBrush x:Key="SuccessTextBrush"      Color="#6EE7B7" />
    <SolidColorBrush x:Key="WarningBgBrush"        Color="#451A03" />
    <SolidColorBrush x:Key="WarningTextBrush"      Color="#FDE68A" />

    <!-- Overlays -->
    <SolidColorBrush x:Key="LoadingOverlayBrush"   Color="#CC0F172A" />

    <!-- Dashboard Stat Icon Circles -->
    <SolidColorBrush x:Key="StatIconBg1"           Color="#500724" />
    <SolidColorBrush x:Key="StatIconFg1"           Color="#F472B6" />
    <SolidColorBrush x:Key="StatIconBg2"           Color="#500724" />
    <SolidColorBrush x:Key="StatIconFg2"           Color="#F472B6" />
    <SolidColorBrush x:Key="StatIconBg3"           Color="#450A0A" />
    <SolidColorBrush x:Key="StatIconFg3"           Color="#F87171" />
    <SolidColorBrush x:Key="StatIconBg4"           Color="#2E1065" />
    <SolidColorBrush x:Key="StatIconFg4"           Color="#C4B5FD" />

    <!-- Financial Gradients -->
    <LinearGradientBrush x:Key="RevenueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0" />
        <GradientStop Color="#047857" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="RevenueSubtitleBrush"  Color="#A7F3D0" />
    <SolidColorBrush x:Key="RevenueWatermarkBrush" Color="#34D399" />
    <LinearGradientBrush x:Key="ExpenseGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#DC2626" Offset="0" />
        <GradientStop Color="#B91C1C" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ExpenseSubtitleBrush"  Color="#FECACA" />
    <SolidColorBrush x:Key="ExpenseWatermarkBrush" Color="#FCA5A5" />

    <!-- P&L Card Colors -->
    <SolidColorBrush x:Key="ProfitTextBrush"       Color="#C4B5FD" />
    <SolidColorBrush x:Key="ProfitBgBrush"         Color="#2E1065" />
    <SolidColorBrush x:Key="OutstandingTextBrush"  Color="#FDE68A" />
    <SolidColorBrush x:Key="OutstandingBgBrush"    Color="#451A03" />

    <!-- P&L Gradient Cards -->
    <LinearGradientBrush x:Key="ProfitGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6D28D9" Offset="0" />
        <GradientStop Color="#5B21B6" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="ProfitSubtitleBrush"   Color="#C4B5FD" />
    <SolidColorBrush x:Key="ProfitWatermarkBrush"  Color="#A78BFA" />
    <LinearGradientBrush x:Key="OutstandingGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B45309" Offset="0" />
        <GradientStop Color="#92400E" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="OutstandingSubtitleBrush"  Color="#FDE68A" />
    <SolidColorBrush x:Key="OutstandingWatermarkBrush" Color="#FBBF24" />

    <!-- Expense Category Chart Bars -->
    <SolidColorBrush x:Key="ChartBarMaterials"  Color="#A78BFA" />
    <SolidColorBrush x:Key="ChartBarTools"      Color="#F472B6" />
    <SolidColorBrush x:Key="ChartBarPackaging"  Color="#FBBF24" />
    <SolidColorBrush x:Key="ChartBarUtilities"  Color="#60A5FA" />
    <SolidColorBrush x:Key="ChartBarOther"      Color="#9CA3AF" />
    <SolidColorBrush x:Key="ChartBarTrack"      Color="#374151" />

    <!-- Notification -->
    <SolidColorBrush x:Key="NotifHeaderBgBrush"    Color="#500724" />
    <SolidColorBrush x:Key="NotifHeaderFgBrush"    Color="#F472B6" />
    <SolidColorBrush x:Key="NotifBadgeBrush"       Color="#EF4444" />
    <SolidColorBrush x:Key="PillNewBgBrush"        Color="#831843" />
    <SolidColorBrush x:Key="PillNewFgBrush"        Color="#F9A8D4" />
    <SolidColorBrush x:Key="PillAckBgBrush"        Color="#334155" />
    <SolidColorBrush x:Key="NotifOverdueBrush"     Color="#FCA5A5" />
    <SolidColorBrush x:Key="NotifDue1DayBrush"     Color="#FDBA74" />
    <SolidColorBrush x:Key="NotifDue3DayBrush"     Color="#FDE68A" />

    <!-- Severity (status pills) -->
    <SolidColorBrush x:Key="RushColor"             Color="#E53935" />
    <SolidColorBrush x:Key="HighColor"             Color="#FB8C00" />
    <SolidColorBrush x:Key="LowColor"              Color="#43A047" />
    <SolidColorBrush x:Key="PaidColor"             Color="#43A047" />
    <SolidColorBrush x:Key="PartialColor"          Color="#FB8C00" />
    <SolidColorBrush x:Key="UnpaidColor"           Color="#E53935" />

    <!-- Customer Profile -->
    <SolidColorBrush x:Key="RevenueCardBgBrush"    Color="#052E16" />
    <SolidColorBrush x:Key="RevenueCardFgBrush"    Color="#6EE7B7" />
    <SolidColorBrush x:Key="BalanceCardBgBrush"    Color="#450A0A" />
    <SolidColorBrush x:Key="BalanceCardFgBrush"    Color="#FCA5A5" />

    <!-- Income / Expense header gradients -->
    <LinearGradientBrush x:Key="IncomeHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#059669" Offset="0" />
        <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="ExpenseHeaderGradient" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#B91C1C" Offset="0" />
        <GradientStop Color="#DC2626" Offset="1" />
    </LinearGradientBrush>

    <!-- P&L gradient summary cards -->
    <LinearGradientBrush x:Key="PLRevenueGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#059669" Offset="0" />
        <GradientStop Color="#10B981" Offset="1" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="PLExpenseGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#B91C1C" Offset="0" />
        <GradientStop Color="#DC2626" Offset="1" />
    </LinearGradientBrush>

    <!-- Gradient card overlay text -->
    <SolidColorBrush x:Key="OverlayWhiteBrush"     Color="#FFFFFF33" />
    <SolidColorBrush x:Key="OverlayTextBrush"      Color="#FFFFFFCC" />

</ResourceDictionary>
